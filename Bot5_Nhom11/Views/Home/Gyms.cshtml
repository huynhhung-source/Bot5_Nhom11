<link rel="stylesheet" href="~/css/gyms.css" asp-append-version="true" />

<section class="gym-hero">
    <div class="container">
        <div class="gym-hero__content">
            <span class="gym-eyebrow">Hệ thống phòng tập Gym Center</span>
            <h1>Tìm phòng tập<br /><strong>gần bạn nhất</strong></h1>
            <p>Không gian hiện đại, thiết bị cao cấp và đội ngũ huấn luyện viên chuyên nghiệp luôn sẵn sàng đồng hành cùng bạn.</p>
            <div class="gym-hero__stats">
                <div><strong>06</strong><span>Chi nhánh</span></div>
                <div><strong>24/7</strong><span>Hỗ trợ hội viên</span></div>
                <div><strong>50+</strong><span>Huấn luyện viên</span></div>
            </div>
        </div>
    </div>
</section>

<section class="gym-directory">
    <div class="container">
        <div class="gym-toolbar">
            <div class="gym-toolbar__heading">
                <span>Khám phá không gian luyện tập</span>
                <h2>Danh sách phòng tập</h2>
            </div>
            <label class="gym-search">
                <i class="fa fa-search"></i>
                <input id="gymSearch" type="search" placeholder="Tìm theo tên hoặc địa chỉ..." />
            </label>
        </div>

        <div class="gym-filters">
            <button class="gym-filter active" type="button" data-area="all">Tất cả</button>
            <button class="gym-filter" type="button" data-area="hcm">TP. Hồ Chí Minh</button>
            <button class="gym-filter" type="button" data-area="hanoi">Hà Nội</button>
            <button class="gym-filter" type="button" data-area="danang">Đà Nẵng</button>
        </div>

        <div class="gym-results">
            <p><strong id="gymCount">@gyms.Length</strong> phòng tập phù hợp</p>
            <button id="nearestGym" type="button"><i class="fa fa-location-arrow"></i> Tìm phòng tập gần tôi</button>
        </div>

        <div class="gym-grid">
            @foreach (var gym in gyms)
            {
                <article class="gym-card" data-area="@gym.Area" data-search="@($"{gym.Name} {gym.Address} {gym.City}")">
                    <div class="gym-card__image">
                        <img src="~/img/gallery/@gym.Image" alt="@gym.Name" />
                        @if (gym.Featured)
                        {
                            <span class="gym-card__badge">Nổi bật</span>
                        }
                        <span class="gym-card__status @(gym.Closing ? "gym-card__status--soon" : "")">
                            <i></i> @(gym.Closing ? "Sắp đóng cửa" : "Đang mở cửa")
                        </span>
                    </div>
                    <div class="gym-card__body">
                        <div class="gym-card__title">
                            <div><span>@gym.City</span><h3>@gym.Name</h3></div>
                            <div class="gym-rating"><i class="fa fa-star"></i> @gym.Rating</div>
                        </div>
                        <p class="gym-address"><i class="fa fa-map-marker"></i> @gym.Address</p>
                        <p class="gym-class-name"><i class="fa fa-calendar"></i> @gym.ClassName</p>
                        <p class="gym-instructor"><i class="fa fa-user"></i> HLV phụ trách: <strong>@gym.Instructor</strong></p>
                        <div class="gym-meta">
                            <span><i class="fa fa-clock-o"></i> @gym.Hours</span>
                            <span><i class="fa fa-phone"></i> @gym.Phone</span>
                            <span class="gym-slots @(gym.AvailableSlots <= 5 ? "gym-slots--low" : "")">
                                <i class="fa fa-users"></i> Còn @gym.AvailableSlots chỗ
                            </span>
                        </div>
                        <div class="gym-amenities">
                            @foreach (var tag in gym.Tags.Split('|'))
                            {
                                <span>@tag</span>
                            }
                        </div>
                        <div class="gym-card__actions">
                            <a class="gym-btn gym-btn--primary" href="/Home/ClassDetail/@gym.Id">Xem chi tiết lớp học</a>
                        </div>
                    </div>
                </article>
            }
        </div>

        <div class="gym-empty" id="gymEmpty">
            <i class="fa fa-map-o"></i>
            <h3>Không tìm thấy phòng tập</h3>
            <p>Hãy thử một từ khóa hoặc khu vực khác.</p>
        </div>
    </div>
</section>

<section class="gym-packages" id="gymPackages">
    <div class="container">
        <div class="gym-packages__heading">
            <span>Gói hội viên tại phòng tập</span>
            <h2>Chọn gói tập phù hợp</h2>
            <p>Các gói dưới đây sử dụng được tại hệ thống phòng tập Gym Center.</p>
        </div>

        <div class="gym-packages__grid">
            @foreach (var package in Model)
            {
                <article class="gym-package-card">
                    <h3>@package.PackageName</h3>
                    <div class="gym-package-card__price">
                        <strong>@package.Price.ToString("N0")₫</strong>
                        <span>/ @(Math.Max(1, package.DurationDays / 30)) tháng</span>
                    </div>
                    <p>@package.Description</p>
                    <ul>
                        @foreach (var feature in (package.Features ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries))
                        {
                            <li><i class="fa fa-check"></i> @feature.Trim()</li>
                        }
                    </ul>
                    <a href="/Packages/Detail/@package.PackageId">Xem chi tiết</a>
                </article>
            }
        </div>

        <div class="gym-packages__more">
            <a href="/Packages/Offline">Xem tất cả gói tập tại phòng</a>
        </div>
    </div>
</section>

<section class="gym-cta">
    <div class="container">
        <div class="gym-cta__inner">
            <div><span>Bắt đầu ngay hôm nay</span><h2>Trải nghiệm buổi tập đầu tiên miễn phí</h2></div>
            <a href="/customer/account/register">Đăng ký trải nghiệm <i class="fa fa-long-arrow-right"></i></a>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const cards = [...document.querySelectorAll('.gym-card')];
            const filters = [...document.querySelectorAll('.gym-filter')];
            const search = document.getElementById('gymSearch');
            const count = document.getElementById('gymCount');
            const empty = document.getElementById('gymEmpty');
            let area = 'all';
            const normalize = value => value.toLocaleLowerCase('vi').normalize('NFD').replace(/[\u0300-\u036f]/g, '');

            function applyFilters() {
                const keyword = normalize(search.value.trim());
                let visible = 0;
                cards.forEach(card => {
                    const show = (area === 'all' || card.dataset.area === area)
                        && (!keyword || normalize(card.dataset.search).includes(keyword));
                    card.hidden = !show;
                    if (show) visible++;
                });
                count.textContent = visible;
                empty.classList.toggle('show', visible === 0);
            }

            filters.forEach(button => button.addEventListener('click', () => {
                filters.forEach(item => item.classList.remove('active'));
                button.classList.add('active');
                area = button.dataset.area;
                applyFilters();
            }));
            search.addEventListener('input', applyFilters);
            document.getElementById('nearestGym').addEventListener('click', () => {
                if (!navigator.geolocation) return alert('Trình duyệt của bạn chưa hỗ trợ định vị.');
                navigator.geolocation.getCurrentPosition(
                    () => alert('Đã xác định vị trí. Chi nhánh Nguyễn Huệ là phòng tập phù hợp gần bạn.'),
                    () => alert('Không thể lấy vị trí. Vui lòng cho phép quyền truy cập vị trí.')
                );
            });
        })();
    </script>
}
