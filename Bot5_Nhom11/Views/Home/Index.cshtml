@{
    ViewData["Title"] = "Gym | Template";
}

<!-- Hero Section Begin -->
<section class="hero-section">
    <div class="hs-slider owl-carousel">
        <div class="hs-item set-bg" data-setbg="img/hero/hero-1.jpg">
            <div class="container">
                <div class="row">
                    <div class="col-lg-6 offset-lg-6">
                        <div class="hi-text">
                            <span>Tạo hình cơ thể của bạn</span>
                            <h1>Hãy <strong>mạnh mẽ</strong> tập luyện chăm chỉ</h1>
                            <a href="#" class="primary-btn">Tìm hiểu thêm</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="hs-item set-bg" data-setbg="img/hero/hero-2.jpg">
            <div class="container">
                <div class="row">
                    <div class="col-lg-6 offset-lg-6">
                        <div class="hi-text">
                            <span>Tạo hình cơ thể của bạn</span>
                            <h1>Hãy <strong>mạnh mẽ</strong> tập luyện chăm chỉ</h1>
                            <a href="#" class="primary-btn">Tìm hiểu thêm</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Hero Section End -->
<!-- ChoseUs Section Begin -->
<section class="choseus-section spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-title">
                    <span>Tại sao chọn chúng tôi?</span>
                    <h2>VƯỢT QUA GIỚI HẠN CỦA BẠN</h2>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-3 col-sm-6">
                <div class="cs-item">
                    <span class="flaticon-034-stationary-bike"></span>
                    <h4>Thiết bị hiện đại</h4>
                    <p>
                        Chúng tôi cung cấp những thiết bị tập luyện mới nhất và hiện đại nhất từ các hãng hàng đầu thế giới.
                    </p>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6">
                <div class="cs-item">
                    <span class="flaticon-033-juice"></span>
                    <h4>Kế hoạch dinh dưỡng lành mạnh</h4>
                    <p>
                        Được tư vấn chi tiết từ các chuyên gia dinh dưỡng để giúp bạn đạt được mục tiêu tập luyện.
                    </p>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6">
                <div class="cs-item">
                    <span class="flaticon-002-dumbell"></span>
                    <h4>Kế hoạch tập luyện chuyên nghiệp</h4>
                    <p>
                        Huấn luyện viên chứng chỉ quốc tế sẽ tạo ra kế hoạch tập luyện riêng cho bạn.
                    </p>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6">
                <div class="cs-item">
                    <span class="flaticon-014-heart-beat"></span>
                    <h4>Phù hợp với nhu cầu của bạn</h4>
                    <p>
                        Tất cả chương trình đều được cá nhân hóa để phù hợp với mục tiêu và tình trạng sức khỏe của bạn.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- ChoseUs Section End -->
<!-- Classes Section Begin -->


