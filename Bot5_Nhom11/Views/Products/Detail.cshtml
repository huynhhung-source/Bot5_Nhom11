@model doanweb.Models.Product

@{
    ViewData["Title"] = Model.ProductName;
}

<!-- Breadcrumb -->
<section class="breadcrumb-section">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                @* <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/Products">Sản phẩm</a></li>
                <li class="breadcrumb-item"><a href="/Products/Category?categoryName=@Model.Category">@Model.Category</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.ProductName</li> *@
            </ol>
        </nav>
    </div>
</section>

<!-- Product Detail Section -->
<section class="product-detail-section">
    <div class="container">
        <div class="row">
            <!-- Product Image -->
            <div class="col-lg-5 col-md-6 mb-4">
                <div class="product-detail-image">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.ProductName" class="img-fluid">
                    }
                    else
                    {
                        <div class="placeholder-image-large">
                            <i class="fa fa-cube"></i>
                        </div>
                    }
                    <div class="product-category-badge">@Model.Category</div>
                </div>
            </div>

            <!-- Product Info -->
            <div class="col-lg-7 col-md-6">
                <div class="product-info">
                    <h1 class="product-title">@Model.ProductName</h1>
                    
                    <div class="product-meta">
                        <div class="meta-item">
                            <strong>Thương hiệu:</strong> <span>@Model.Brand</span>
                        </div>
                        <div class="meta-item">
                            <strong>Đơn vị:</strong> <span>@Model.Unit</span>
                        </div>
                    </div>

                    <div class="product-stock-info">
                        @if (Model.StockQuantity > 0)
                        {
                            <span class="stock-available">
                                <i class="fa fa-check-circle"></i> Còn hàng (@Model.StockQuantity @Model.Unit có sẵn)
                            </span>
                        }
                        else
                        {
                            <span class="stock-unavailable">
                                <i class="fa fa-times-circle"></i> Hết hàng
                            </span>
                        }
                    </div>

                    <div class="product-price-detail">
                        <div class="price-label">Giá:</div>
                        <h2 class="price">@Model.Price.ToString("N0") <span>đ</span></h2>
                    </div>

                    <div class="product-description-detail">
                        <h4>Mô Tả Sản Phẩm</h4>
                        <p>@Model.Description</p>
                    </div>

                    <div class="product-actions">
                        @if (Model.StockQuantity > 0)
                        {
                            <div style="display: flex; align-items: center; gap: 10px; flex: 1;">
                                <button class="qty-btn-detail" onclick="decreaseQty()" id="qty-minus">-</button>
                                <input type="number" id="product-qty" class="qty-input-detail" value="1" min="1" max="@Model.StockQuantity">
                                <button class="qty-btn-detail" onclick="increaseQty('@Model.StockQuantity')" id="qty-plus">+</button>
                            </div>
                            <button class="btn-add-to-cart" onclick="addProductToCart(@Model.ProductId, '@Model.ProductName', @Model.Price, '@Model.ImageUrl', @Model.StockQuantity)">
                                <i class="fa fa-shopping-cart"></i> Thêm vào giỏ
                            </button>
                        }
                        else
                        {
                            <button class="btn-add-to-cart" disabled>
                                <i class="fa fa-ban"></i> Hết hàng
                            </button>
                        }
                        <button class="btn-wishlist" title="Thêm vào danh sách yêu thích">
                            <i class="fa fa-heart"></i>
                        </button>
                    </div>

                    <div class="product-info-box">
                        <h4>Thông Tin Chi Tiết</h4>
                        <table class="info-table">
                            <tr>
                                <td><strong>Danh mục:</strong></td>
                                <td>@Model.Category</td>
                            </tr>
                            <tr>
                                <td><strong>Thương hiệu:</strong></td>
                                <td>@Model.Brand</td>
                            </tr>
                            <tr>
                                <td><strong>Đơn vị:</strong></td>
                                <td>@Model.Unit</td>
                            </tr>
                            <tr>
                                <td><strong>Tồn kho:</strong></td>
                                <td>@Model.StockQuantity @Model.Unit</td>
                            </tr>
                            <tr>
                                <td><strong>Trạng thái:</strong></td>
                                <td>
                                    @if (Model.Status == "Active")
                                    {
                                        <span class="badge badge-active">Còn bán</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-inactive">Ngừng bán</span>
                                    }
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Related Products Section -->
@if (ViewBag.RelatedProducts != null && ((List<doanweb.Models.Product>)ViewBag.RelatedProducts).Count > 0)
{
    <section class="related-products-section">
        <div class="container">
            <div class="section-title-wrapper">
                <h3 class="section-title">Sản Phẩm Liên Quan</h3>
            </div>
            <div class="row">
                @foreach (var relatedProduct in (List<doanweb.Models.Product>)ViewBag.RelatedProducts)
                {
                    <div class="col-lg-3 col-md-6 col-sm-12 mb-4">
                        <div class="product-card">
                            <div class="product-image">
                                @if (!string.IsNullOrEmpty(relatedProduct.ImageUrl))
                                {
                                    <img src="@relatedProduct.ImageUrl" alt="@relatedProduct.ProductName" class="img-fluid">
                                }
                                else
                                {
                                    <div class="placeholder-image">
                                        <i class="fa fa-cube"></i>
                                    </div>
                                }
                                <div class="product-badge">@relatedProduct.Category</div>
                            </div>
                            <div class="product-body">
                                <h5 class="product-name">@relatedProduct.ProductName</h5>
                                <p class="product-brand">@relatedProduct.Brand</p>
                                <div class="product-price">
                                    <h4>@relatedProduct.Price.ToString("N0") <span>đ</span></h4>
                                </div>
                                <a href="/Products/Detail/@relatedProduct.ProductId" class="btn-view-detail">
                                    <i class="fa fa-eye"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<style>
