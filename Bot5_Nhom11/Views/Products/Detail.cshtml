    }

    .product-image {
        position: relative;
        overflow: hidden;
        height: 220px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .product-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .product-card:hover .product-image img {
        transform: scale(1.08);
    }

    .placeholder-image {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        font-size: 50px;
    }

    .product-badge {
        position: absolute;
        top: 10px;
        right: 10px;
        background-color: #f36100;
        color: white;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .product-body {
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .product-name {
        font-size: 14px;
        font-weight: 700;
        color: #222;
        line-height: 1.4;
        margin: 0;
    }

    .product-brand {
        color: #f36100;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin: 0;
    }

    .product-price {
        margin-top: 10px;
        padding-top: 10px;
        border-top: 1px solid #f0f0f0;
    }

    .product-price h4 {
        margin: 0;
        color: #f36100;
        font-weight: 700;
        font-size: 16px;
    }

    .product-price span {
        font-size: 12px;
    }

    .btn-view-detail {
        padding: 10px 15px;
        background-color: #f36100;
        color: white;
        text-decoration: none;
        border-radius: 5px;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 600;
        width: 45px;
        height: 45px;
        align-self: flex-end;
    }

    .btn-view-detail:hover {
        background-color: #d94d00;
        box-shadow: 0 4px 12px rgba(243, 97, 0, 0.3);
    }

    .product-actions {
        display: flex;
        gap: 12px;
        margin-bottom: 35px;
        align-items: center;
    }

    .qty-btn-detail {
        width: 42px;
        height: 42px;
        border: 1px solid #ddd;
        background: white;
        border-radius: 4px;
        cursor: pointer;
        font-size: 18px;
        font-weight: 700;
        color: #f36100;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .qty-btn-detail:hover {
        border-color: #f36100;
        background: #f36100;
        color: white;
    }

    .qty-input-detail {
        width: 60px;
        height: 42px;
        text-align: center;
        border: 1px solid #ddd;
        border-radius: 4px;
        padding: 0;
        font-size: 16px;
        font-weight: 700;
        color: #222;
    }

    .qty-input-detail:focus {
        outline: none;
        border-color: #f36100;
        box-shadow: 0 0 0 2px rgba(243, 97, 0, 0.1);
    }
</style>

@{
    var productId = Model.ProductId;
    var productName = Model.ProductName;
    var productPrice = Model.Price;
}

<script>
    function increaseQty(maxStock) {
        const qtyInput = document.getElementById('product-qty');
        const currentQty = parseInt(qtyInput.value) || 1;
        const max = parseInt(maxStock);
        
        if (currentQty < max) {
            qtyInput.value = currentQty + 1;
        }
    }

    function decreaseQty() {
        const qtyInput = document.getElementById('product-qty');
        const currentQty = parseInt(qtyInput.value) || 1;
        
        if (currentQty > 1) {
            qtyInput.value = currentQty - 1;
        }
    }

    function addProductToCart(productId, productName, price, imageUrl, stockQuantity) {
        const qtyInput = document.getElementById('product-qty');
        const maxStock = parseInt(stockQuantity, 10) || 0;
        let quantity = parseInt(qtyInput.value, 10) || 1;

        if (quantity > maxStock) {
            quantity = maxStock;
            qtyInput.value = maxStock;
        }

        cart.addProduct(productId, productName, price, imageUrl, quantity, maxStock);
        qtyInput.value = 1;
    }

    function addToCart(id, name, price) {
        alert('Thêm ' + name + ' vào giỏ hàng thành công!');
    }
</script>
