@model WorkoutScheduleDetailsViewModel

@{
    ViewData["Title"] = "Chi tiết giờ tập";
    var item = Model.Schedule;
}

<section class="schedule-detail-page">
    <div class="schedule-detail-shell">
        <div class="schedule-detail-heading">
            <div>
                <span>GymPro</span>
                <h1>Chi tiết giờ tập</h1>
            </div>
            <a href="/Schedule/MySchedule">Quay lại lịch cá nhân</a>
        </div>

        <article class="schedule-detail-card">
            <div class="schedule-detail-time">
                <strong>@item.StartTime.ToString(@"hh\:mm")</strong>
                <span>@item.EndTime.ToString(@"hh\:mm")</span>
            </div>
            <div class="schedule-detail-content">
                <h2>@item.ClassName</h2>
                <p>@Model.Description</p>
                <div class="schedule-detail-grid">
                    <div><span>Ngày tập</span><strong>@item.ClassDate.ToString("dd/MM/yyyy")</strong></div>
                    <div><span>Loại hình</span><strong>@item.ClassType</strong></div>
                    <div><span>Huấn luyện viên</span><strong>@item.InstructorName</strong></div>
                    <div><span>Phòng tập</span><strong>@item.RoomName</strong></div>
                    <div><span>Số người đăng ký</span><strong>@item.RegisteredCount/@item.Capacity</strong></div>
                    <div><span>Trạng thái</span><strong>@(item.HasCheckedIn ? "Đã check-in" : item.Status)</strong></div>
                </div>
            </div>
        </article>

        <div class="schedule-detail-actions">
            <form method="post" action="/Schedule/CheckIn">
                @Html.AntiForgeryToken()
                <input type="hidden" name="classId" value="@item.ClassId" />
                <button type="submit" disabled="@(!item.CanCheckIn)">
                    @(item.HasCheckedIn ? "Đã check-in" : "Check-in")
                </button>
            </form>
            <form method="post" action="/Schedule/Cancel" onsubmit="return confirm('Bạn chắc chắn muốn hủy lịch này?');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="classId" value="@item.ClassId" />
                <input type="hidden" name="date" value="@item.ClassDate.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="returnTo" value="MySchedule" />
                <button class="secondary" type="submit" disabled="@(!item.CanCancel)">Hủy lịch</button>
            </form>
        </div>
    </div>
</section>

<style>
    .schedule-detail-page { min-height: 100vh; padding: 58px 0 90px; background: #080808; color: #fff; }
    .schedule-detail-shell { width: min(1050px, calc(100% - 40px)); margin: 0 auto; }
    .schedule-detail-heading { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 26px; }
    .schedule-detail-heading span { color: #f36100; font-weight: 800; text-transform: uppercase; }
    .schedule-detail-heading h1 { margin: 4px 0 0; color: #fff; font-family: Oswald, sans-serif; text-transform: uppercase; }
    .schedule-detail-heading a { padding: 12px 16px; background: #f36100; color: #fff; font-weight: 800; text-decoration: none; }
    .schedule-detail-card { display: grid; grid-template-columns: 180px 1fr; gap: 28px; padding: 30px; background: #151515; border: 1px solid #303034; }
    .schedule-detail-time strong { display: block; color: #f36100; font-size: 42px; font-family: Oswald, sans-serif; }
    .schedule-detail-time span { color: #b5bfd0; font-size: 22px; }
    .schedule-detail-content h2 { margin: 0 0 10px; color: #fff; font-family: Oswald, sans-serif; text-transform: uppercase; }
    .schedule-detail-content p { color: #aab4c5; }
    .schedule-detail-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin-top: 24px; }
    .schedule-detail-grid div { padding: 16px; background: #101011; border: 1px solid #29292c; }
    .schedule-detail-grid span, .schedule-detail-grid strong { display: block; }
    .schedule-detail-grid span { color: #8995aa; margin-bottom: 5px; }
    .schedule-detail-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 18px; }
    .schedule-detail-actions form { margin: 0; }
    .schedule-detail-actions button { width: 100%; min-height: 46px; border: 0; background: #f36100; color: #fff; font-family: Oswald, sans-serif; font-weight: 800; text-transform: uppercase; cursor: pointer; }
    .schedule-detail-actions button.secondary { background: #30343c; }
    .schedule-detail-actions button:disabled { background: #555; cursor: not-allowed; }
    @@media (max-width: 700px) { .schedule-detail-heading { align-items: stretch; flex-direction: column; } .schedule-detail-card { grid-template-columns: 1fr; } .schedule-detail-grid, .schedule-detail-actions { grid-template-columns: 1fr; } }
</style>
