@{
    ViewData["Title"] = "Lỗi Thanh Toán";
    var errorMessage = ViewBag.ErrorMessage as string ?? "Đã xảy ra lỗi khi xử lý thanh toán";
}

<section class="breadcrumb-section set-bg" style="background: #151515; min-height: 300px; display: flex; align-items: center; justify-content: center;">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="breadcrumb-text">
                    <h2 style="color: white; font-size: 48px; font-weight: 600; text-transform: uppercase;">Lỗi Thanh Toán</h2>
                    <div class="bt-option" style="margin-top: 20px;">
                        <a href="/" style="color: white; font-size: 16px; font-weight: 700; margin-right: 20px;">Trang chủ</a>
                        <span style="color: #f36100; font-size: 16px; font-weight: 700;">Lỗi</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="pricing-section spad" style="background: #151515; padding: 100px 0;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div style="background: white; padding: 50px; border-radius: 10px; text-align: center;">
                    <div style="font-size: 60px; color: #dc3545; margin-bottom: 20px;"><i class="fa fa-exclamation-circle"></i></div>
                    <h1 style="color: #111; margin-bottom: 20px; font-size: 32px;">Lỗi Thanh Toán</h1>
                    <p style="color: #666; font-size: 16px; margin-bottom: 30px; line-height: 1.8;">@errorMessage</p>

                    <div style="background: #f8f9fa; padding: 30px; border-radius: 5px; margin-bottom: 30px; border-left: 4px solid #dc3545; text-align: left;">
                        <h3 style="color: #111; margin-bottom: 20px;">Cách Khắc Phục</h3>
                        <ul style="list-style: none; padding: 0;">
                            <li style="color: #666; font-size: 16px; line-height: 2;"><i class="fa fa-check-circle" style="color: #f36100; margin-right: 10px;"></i>Kiểm tra kết nối internet của bạn</li>
                            <li style="color: #666; font-size: 16px; line-height: 2;"><i class="fa fa-check-circle" style="color: #f36100; margin-right: 10px;"></i>Thử lại sau vài phút</li>
                            <li style="color: #666; font-size: 16px; line-height: 2;"><i class="fa fa-check-circle" style="color: #f36100; margin-right: 10px;"></i>Xóa bộ nhớ đệm trình duyệt và thử lại</li>
                            <li style="color: #666; font-size: 16px; line-height: 2;"><i class="fa fa-check-circle" style="color: #f36100; margin-right: 10px;"></i>Liên hệ với bộ phận hỗ trợ</li>
                        </ul>
                    </div>

                    <div style="background: #d1ecf1; color: #0c5460; padding: 15px; border-radius: 5px; margin-bottom: 30px;">
                        <i class="fa fa-phone"></i> <strong>Liên hệ hỗ trợ:</strong> 125-711-811 hoặc Support.gymcenter@gmail.com
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                        <a href="/" class="primary-btn" style="background: #f36100; color: white; padding: 15px; border-radius: 5px; font-weight: 700; text-transform: uppercase;"><i class="fa fa-home"></i> Trang Chủ</a>
                        <a href="/packages/online" class="primary-btn" style="color: #f36100; border: 2px solid #f36100; padding: 13px; border-radius: 5px; font-weight: 700; text-transform: uppercase;"><i class="fa fa-shopping-bag"></i> Quay Lại Gói Tập</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
