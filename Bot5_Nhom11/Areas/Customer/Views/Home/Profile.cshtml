@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    var userName = Context.Session.GetString("UserName");
    var userEmail = Context.Session.GetString("UserEmail");
}

<div class="container mt-5">
    <h1>Hồ sơ cá nhân</h1>
    <div class="row mt-4">
        <div class="col-md-3">
            <div class="card mb-4">
                <div class="card-body text-center">
                    <div style="width: 120px; height: 120px; background: #f36100; border-radius: 50%; margin: 0 auto 20px; display: flex; align-items: center; justify-content: center;">
                        <i class="fa fa-user" style="font-size: 60px; color: white;"></i>
                    </div>
                    <h5>@userName</h5>
                    <p>@userEmail</p>
                    <span class="badge badge-success">Hoạt động</span>
                </div>
            </div>
            <div class="card">
                <div class="card-header bg-dark text-white"><h6 class="mb-0">Thông tin tài khoản</h6></div>
                <div class="card-body">
                    <p><strong>Ngày tham gia:</strong> @DateTime.Now.ToString("dd/MM/yyyy")</p>
                    <p><strong>Trạng thái:</strong> Hoạt động</p>
                </div>
            </div>
        </div>

        <div class="col-md-9">
            <div class="card mb-4">
                <div class="card-header bg-dark text-white"><h5 class="mb-0">Chỉnh sửa hồ sơ</h5></div>
                <div class="card-body">
                    <form method="post" action="/customer/home/UpdateProfile">
                        <div class="row">
                            <div class="col-md-6 form-group mb-3">
                                <label>Họ tên</label>
                                <input name="FullName" type="text" class="form-control" value="@userName" placeholder="Nhập họ tên" />
                            </div>
                            <div class="col-md-6 form-group mb-3">
                                <label>Email</label>
                                <input type="email" class="form-control" value="@userEmail" readonly />
                            </div>
                        </div>
                        <div class="form-group mb-3">
                            <label>Số điện thoại</label>
                            <input name="PhoneNumber" type="tel" class="form-control" placeholder="Nhập số điện thoại" />
                        </div>
                        <div class="form-group mb-3">
                            <label>Địa chỉ</label>
                            <input name="Address" type="text" class="form-control" placeholder="Nhập địa chỉ" />
                        </div>
                        <button type="submit" class="btn btn-primary" style="background: #f36100; border: none;">
                            <i class="fa fa-save"></i> Lưu thay đổi
                        </button>
                        <a href="/customer/home/index" class="btn btn-secondary">Hủy</a>
                    </form>
                </div>
            </div>

            <div class="card">
                <div class="card-header bg-dark text-white"><h5 class="mb-0">Đổi mật khẩu</h5></div>
                <div class="card-body">
                    <form method="post" action="/customer/home/ChangePassword">
                        <div class="form-group mb-3">
                            <label>Mật khẩu hiện tại</label>
                            <input name="CurrentPassword" type="password" class="form-control" placeholder="Nhập mật khẩu hiện tại" />
                        </div>
                        <div class="form-group mb-3">
                            <label>Mật khẩu mới</label>
                            <input name="NewPassword" type="password" class="form-control" placeholder="Nhập mật khẩu mới" />
                        </div>
                        <button type="submit" class="btn btn-warning" style="background: #f36100; border: none; color: white;">
                            <i class="fa fa-refresh"></i> Đổi mật khẩu
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .badge-success { background-color: #28a745; color: white; padding: 8px 12px; }
    .form-control:focus { border-color: #f36100; box-shadow: 0 0 0 .2rem rgba(243,97,0,.25); }
</style>
