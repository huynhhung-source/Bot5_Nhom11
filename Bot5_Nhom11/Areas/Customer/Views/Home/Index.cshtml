@{
    ViewData["Title"] = "Trang khách hàng";
    var userName = Context.Session.GetString("UserName");
}

<div class="container mt-5">
    <h1>Trang khách hàng</h1>
    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-dark text-white">
                    <h5>Thông tin tài khoản khách hàng</h5>
                </div>
                <div class="card-body">
                    <p>Chào mừng @userName đến với không gian cá nhân!</p>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="card text-center bg-light">
                                <div class="card-body">
                                    <h5 class="card-title">Hồ sơ cá nhân</h5>
                                    <p class="card-text">Cập nhật thông tin cá nhân của bạn</p>
                                    <a href="/customer/account/profile" class="btn btn-primary mt-3">Xem hồ sơ</a>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card text-center bg-light">
                                <div class="card-body">
                                    <h5 class="card-title">Gói tập của tôi</h5>
                                    <p class="card-text">Xem các gói tập bạn đã đăng ký</p>
                                    <a href="/Order/MyPackages" class="btn btn-primary mt-3">Xem gói tập</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
