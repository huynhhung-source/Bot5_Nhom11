@model List<doanweb.Models.Package>

@{
    ViewData["Title"] = "Quản lý Gói Tập";
    var subscriptions = ViewBag.Subscriptions as List<doanweb.Models.AdminPackageSubscriptionViewModel> ?? new();
    var subscribedPackageIds = subscriptions.Select(s => s.PackageId).ToHashSet();
    var packagesWithoutCustomer = Model.Where(p => !subscribedPackageIds.Contains(p.PackageId)).ToList();
}

<div class="container mt-5">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa fa-exclamation-circle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card" style="box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        <div class="card-header bg-dark text-white">
            <div class="row align-items-center gy-2">
                <div class="col-md-4">
                    <h5 style="margin: 0;">Quản lý Gói Tập</h5>
                </div>
                <div class="col-md-5">
                    <div class="package-search">
                        <i class="fa fa-search"></i>
                        <input id="packageSearchInput"
                               type="search"
                               class="form-control form-control-sm"
                               placeholder="Tìm khách hàng, email, gói tập, trạng thái..."
                               autocomplete="off" />
                    </div>
                </div>
                <div class="col-md-3 text-end">
                    <a href="/admin/package/create" class="btn btn-primary btn-sm" style="background: #f36100; border: none;">
                        <i class="fa fa-plus"></i> Thêm Gói Tập Mới
                    </a>
                </div>
            </div>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table id="packageManagementTable" class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 6%;">Id</th>
                            <th style="width: 18%;">Khách Hàng</th>
                            <th style="width: 16%;">Gói Tập</th>
                            <th style="width: 17%;">Thời gian</th>
                            <th style="width: 10%;">Buổi Học</th>
                            <th style="width: 12%;">Trạng Thái</th>
                            <th style="width: 11%;">Gia Hạn</th>
                            <th style="width: 10%;">Hành Động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in subscriptions)
                        {
                            <tr data-search="@($"{item.SubscriptionId} {item.CustomerName} {item.CustomerEmail} {item.PackageName} {item.Status}").ToLowerInvariant()">
                                <td>
                                    <span class="badge bg-secondary">@item.SubscriptionId</span>
                                </td>
                                <td>
                                    <strong>@item.CustomerName</strong>
                                    <div class="text-muted small">@item.CustomerEmail</div>
                                </td>
                                <td>@item.PackageName</td>
                                <td>
                                    @item.StartDate.ToString("dd/MM/yyyy") - @item.EndDate.ToString("dd/MM/yyyy")
                                    <div class="text-muted small">Còn @item.RemainingDays ngày</div>
                                </td>
                                <td>@item.SessionsUsed / @item.MaxSessions</td>
                                <td>
                                    @if (item.Status == "Active")
                                    {
                                        <span class="badge bg-success">Đang hoạt động</span>
                                    }
                                    else if (item.Status == "Expired")
                                    {
                                        <span class="badge bg-danger">Hết hạn</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@item.Status</span>
                                    }
                                </td>
                                <td>
                                    <form method="post" action="/admin/package/renewsubscription" class="d-flex gap-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="subscriptionId" value="@item.SubscriptionId" />
                                        <input type="number" name="extraDays" min="1" value="30" class="form-control form-control-sm package-renew-days" />
                                        <button type="submit" class="btn btn-sm btn-success">
                                            <i class="fa fa-refresh"></i>
                                        </button>
                                    </form>
                                </td>
                                <td>
                                    <div class="package-actions">
                                        <a href="/admin/package/edit/@item.PackageId" class="btn btn-sm btn-warning" title="Sửa gói tập">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-danger" onclick="deletePackage(@item.PackageId, '@item.PackageName')" title="Xóa hoặc ẩn gói tập">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }

                        @foreach (var package in packagesWithoutCustomer)
                        {
                            <tr data-search="@($"{package.PackageId} chưa có khách {package.PackageName} {package.Status}").ToLowerInvariant()">
                                <td>
                                    <span class="badge bg-secondary">@package.PackageId</span>
                                </td>
                                <td>
                                    <strong>Chưa có khách</strong>
                                    <div class="text-muted small">Gói chưa được đăng ký</div>
                                </td>
                                <td>@package.PackageName</td>
                                <td>
                                    @package.DurationDays ngày
                                    <div class="text-muted small">Chưa kích hoạt</div>
                                </td>
                                <td>0 / @package.MaxSessions</td>
                                <td>
                                    @if (package.Status == "Active")
                                    {
                                        <span class="badge bg-success">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Không hoạt động</span>
                                    }
                                </td>
                                <td>
                                    <span class="text-muted small">Chưa có khách</span>
                                </td>
                                <td>
                                    <div class="package-actions">
                                        <a href="/admin/package/edit/@package.PackageId" class="btn btn-sm btn-warning" title="Sửa gói tập">
                                            <i class="fa fa-edit"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-danger" onclick="deletePackage(@package.PackageId, '@package.PackageName')" title="Xóa hoặc ẩn gói tập">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div id="packageNoResults" class="alert alert-info d-none mt-3">
                <i class="fa fa-info-circle"></i> Không tìm thấy dữ liệu phù hợp.
            </div>
        </div>
    </div>
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: #f5f5f5;
        transition: background-color 0.3s;
    }

    .btn-sm {
        padding: 0.4rem 0.8rem;
        font-size: 0.875rem;
    }

    .badge {
        padding: 0.5rem 0.75rem;
        font-size: 0.85rem;
    }

    .package-search {
        position: relative;
    }

    .package-search i {
        position: absolute;
        top: 50%;
        left: 10px;
        color: #6c757d;
        transform: translateY(-50%);
        pointer-events: none;
    }

    .package-search input {
        padding-left: 32px;
    }

    .package-renew-days {
        width: 74px;
    }

    .package-actions {
        display: flex;
        gap: 6px;
    }
</style>

@section Scripts {
    <script>
        const packageSearchInput = document.getElementById('packageSearchInput');
        const packageRows = Array.from(document.querySelectorAll('#packageManagementTable tbody tr'));
        const noResults = document.getElementById('packageNoResults');

        if (packageSearchInput) {
            packageSearchInput.addEventListener('input', function () {
                const keyword = this.value.trim().toLowerCase();
                let visibleCount = 0;

                packageRows.forEach(row => {
                    const searchableText = row.dataset.search || row.innerText.toLowerCase();
                    const isVisible = searchableText.includes(keyword);
                    row.style.display = isVisible ? '' : 'none';

                    if (isVisible) {
                        visibleCount++;
                    }
                });

                if (noResults) {
                    noResults.classList.toggle('d-none', visibleCount > 0);
                }
            });
        }

        function deletePackage(packageId, packageName) {
            if (confirm(`Bạn có chắc chắn muốn xóa gói tập "${packageName}"?`)) {
                fetch('/admin/package/delete', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ id: packageId })
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.success) {
                        alert(data.message);
                        location.reload();
                    } else {
                        alert('Lỗi: ' + data.message);
                    }
                })
                .catch(error => {
                    alert('Lỗi khi gửi yêu cầu xóa: ' + error.message);
                });
            }
        }
    </script>
}
