@model List<doanweb.Models.Package>

@{
    ViewData["Title"] = "Quản lý Gói Tập";
}

<div class="container mt-5">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card" style="box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        <div class="card-header bg-dark text-white">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h5 style="margin: 0;">Danh sách Gói Tập</h5>
                </div>
                <div class="col-md-4 text-end">
                    <a href="/admin/package/create" class="btn btn-primary btn-sm" style="background: #f36100; border: none;">
                        <i class="fa fa-plus"></i> Thêm Gói Tập Mới
                    </a>
                </div>
            </div>
        </div>
        <div class="card-body">
            @if (Model.Count == 0)
            {
                <div class="alert alert-info">
                    <i class="fa fa-info-circle"></i> Chưa có gói tập nào. <a href="/admin/package/create">Thêm gói tập</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th style="width: 5%;">ID</th>
                                <th style="width: 20%;">Tên Gói</th>
                                <th style="width: 12%;">Giá (₫)</th>
                                <th style="width: 10%;">Thời Hạn (tháng)</th>
                                <th style="width: 25%;">Mô Tả</th>
                                <th style="width: 10%;">Trạng Thái</th>
                                <th style="width: 18%;">Hành Động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var package in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-secondary">@package.PackageId</span>
                                    </td>
                                    <td>
                                        <strong>@package.PackageName</strong>
                                    </td>
                                    <td>
                                        <span style="color: #f36100; font-weight: 600;">@package.Price.ToString("N0")</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@(package.DurationDays > 0 ? (package.DurationDays / 30) : 0) tháng</span>
                                    </td>
                                    <td>
                                        <span title="@package.Description">
                                            @(package.Description?.Length > 40 ? package.Description.Substring(0, 40) + "..." : package.Description)
                                        </span>
                                    </td>
                                    <td>
                                        @if (package.Status == "Active")
                                        {
                                            <span class="badge bg-success">
                                                <i class="fa fa-check-circle"></i> Hoạt động
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                <i class="fa fa-times-circle"></i> Không hoạt động
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <a href="/admin/package/edit/@package.PackageId" class="btn btn-sm btn-warning" title="Chỉnh sửa">
                                            <i class="fa fa-edit"></i> Sửa
                                        </a>
                                        <button type="button" class="btn btn-sm btn-danger" onclick="deletePackage(@package.PackageId, '@package.PackageName')" title="Xóa">
                                            <i class="fa fa-trash"></i> Xóa
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: #f5f5f5;
        transition: background-color 0.3s;
    }

    .btn-sm {
        padding: 0.4rem 0.8rem;
        font-size: 0.875rem;
    }

    .badge {
        padding: 0.5rem 0.75rem;
        font-size: 0.85rem;
    }
</style>

@section Scripts {
    <script>
        function deletePackage(packageId, packageName) {
            if (confirm(`Bạn có chắc chắn muốn xóa gói tập "${packageName}"?`)) {
                var deleteUrl = `/admin/package/delete`;
                console.log('Deleting package ID:', packageId);
                
                fetch(deleteUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ id: packageId })
                })
                .then(response => {
                    console.log('Response status:', response.status);
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    console.log('Response data:', data);
                    if (data.success) {
                        alert(data.message);
                        location.reload();
                    } else {
                        alert('Lỗi: ' + data.message);
                    }
                })
                .catch(error => {
                    console.error('Fetch error:', error);
                    alert('Lỗi khi gửi yêu cầu xóa: ' + error.message);
                });
            }
        }
    </script>
}
