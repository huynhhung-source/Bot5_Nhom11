@model AdminScheduleFormViewModel

@{
    ViewData["Title"] = "Thêm Giờ Tập";
    ViewData["AdminPageTitle"] = "Thêm Giờ Tập";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-9 offset-md-1">
            <div class="card" style="box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                <div class="card-header bg-dark text-white">
                    <h5 style="margin: 0;">Thêm giờ tập</h5>
                </div>
                <div class="card-body">
                    <form method="post" asp-area="Admin" asp-controller="Schedule" asp-action="Create">
                        @Html.AntiForgeryToken()
                        <partial name="_ScheduleForm" model="Model" />
                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary" style="background: #f36100; border: none;">
                                <i class="fa fa-save"></i> Thêm giờ tập
                            </button>
                            <a asp-area="Admin" asp-controller="Schedule" asp-action="Index" class="btn btn-secondary">
                                <i class="fa fa-times"></i> Hủy
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
