@model List<doanweb.Models.Payment>

@{
    ViewData["Title"] = "Quản lý thanh toán";
    decimal totalRevenue = ViewBag.TotalRevenue ?? 0;
    int successPayments = ViewBag.SuccessPayments ?? 0;
    int failedPayments = ViewBag.FailedPayments ?? 0;
    int totalPayments = ViewBag.TotalPayments ?? 0;
}

<div class="container-fluid mt-4">
    <h2 style="color: #333; margin-bottom: 30px;">
        <i class="fas fa-credit-card" style="color: #f36100; margin-right: 10px;"></i>
        Quản lý thanh toán
    </h2>

    <!-- Thống kê -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card" style="border-left: 4px solid #28a745;">
                <div class="card-body">
                    <h6 class="card-title text-muted">Tổng doanh thu</h6>
                    <h2 style="color: #28a745; font-weight: bold;">@totalRevenue.ToString("N0")₫</h2>
                    <p class="text-muted mb-0">Từ tất cả thanh toán</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card" style="border-left: 4px solid #0066cc;">
                <div class="card-body">
                    <h6 class="card-title text-muted">Tổng thanh toán</h6>
                    <h2 style="color: #0066cc; font-weight: bold;">@totalPayments</h2>
                    <p class="text-muted mb-0">Số lượng giao dịch</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card" style="border-left: 4px solid #28a745;">
                <div class="card-body">
                    <h6 class="card-title text-muted">Thành công</h6>
                    <h2 style="color: #28a745; font-weight: bold;">@successPayments</h2>
                    <p class="text-muted mb-0">Thanh toán thành công</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card" style="border-left: 4px solid #dc3545;">
                <div class="card-body">
                    <h6 class="card-title text-muted">Thất bại</h6>
                    <h2 style="color: #dc3545; font-weight: bold;">@failedPayments</h2>
                    <p class="text-muted mb-0">Thanh toán thất bại</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Bộ lọc -->
    <div class="card" style="box-shadow: 0 2px 8px rgba(0,0,0,0.1); margin-bottom: 20px;">
        <div class="card-header bg-dark text-white">
            <h5 style="margin: 0;"><i class="fa fa-filter"></i> Bộ lọc</h5>
        </div>
        <div class="card-body">
            <form method="get" action="/admin/payment/index" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Trạng thái</label>
                    <select name="status" class="form-control">
                        <option value="">-- Tất cả --</option>
                        <option value="Success">Thành công</option>
                        <option value="Failed">Thất bại</option>
                        <option value="Pending">Chờ xử lý</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Từ ngày</label>
                    <input type="date" name="startDate" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Đến ngày</label>
                    <input type="date" name="endDate" class="form-control" />
                </div>

                <div class="col-md-3" style="display: flex; align-items: flex-end;">
                    <button type="submit" class="btn btn-primary w-100" style="background: #f36100; border: none;">
                        <i class="fa fa-search"></i> Tìm kiếm
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng thanh toán -->
    <div class="card" style="box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        <div class="card-header bg-dark text-white">
            <h5 style="margin: 0;">Danh sách thanh toán</h5>
        </div>
        <div class="card-body">
            @if (Model.Count == 0)
            {
                <div class="alert alert-info">
                    <i class="fa fa-info-circle"></i> Không có thanh toán nào.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Khách hàng</th>
                                <th>Số tiền</th>
                                <th>Phương thức</th>
                                <th>Mã giao dịch</th>
                                <th>Ngày thanh toán</th>
                                <th>Trạng thái</th>
                                <th>Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var payment in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-secondary">@payment.PaymentId</span>
                                    </td>
                                    <td>
                                        <strong>@payment.User?.FullName</strong>
                                        <br />
                                        <small style="color: #666;">@payment.User?.Email</small>
                                    </td>
                                    <td>
                                        <span style="color: #28a745; font-weight: 700;">@payment.Amount.ToString("N0")₫</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@payment.PaymentMethod</span>
                                    </td>
                                    <td>
                                        <small>@payment.TransactionId</small>
                                    </td>
                                    <td>
                                        @payment.PaymentDate.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td>
                                        @if (payment.Status == "Success")
                                        {
                                            <span class="badge bg-success">
                                                <i class="fa fa-check-circle"></i> Thành công
                                            </span>
                                        }
                                        else if (payment.Status == "Failed")
                                        {
                                            <span class="badge bg-danger">
                                                <i class="fa fa-times-circle"></i> Thất bại
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">
                                                <i class="fa fa-hourglass-half"></i> Chờ xử lý
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <a href="/admin/payment/details/@payment.PaymentId" class="btn btn-sm btn-info" title="Xem chi tiết">
                                            <i class="fa fa-eye"></i> Xem
                                        </a>
                                        <button type="button" class="btn btn-sm btn-secondary" onclick="viewDetails(@payment.PaymentId, '@payment.User?.FullName', '@payment.Amount.ToString("N0")', '@payment.TransactionId', '@payment.PaymentDate.ToString("dd/MM/yyyy HH:mm")')" title="Xem nhanh">
                                            <i class="fa fa-search"></i> Chi tiết
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .card {
        border: none;
        border-radius: 8px;
    }

    .btn-sm {
        padding: 0.4rem 0.8rem;
        font-size: 0.875rem;
    }

    .badge {
        padding: 0.5rem 0.75rem;
        font-size: 0.85rem;
    }
</style>

<!-- Modal xem chi tiết -->
<div class="modal fade" id="detailsModal" tabindex="-1" role="dialog" aria-labelledby="detailsModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="detailsModalLabel">Chi tiết thanh toán</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-6">
                        <strong>Khách hàng:</strong>
                    </div>
                    <div class="col-6" id="modalCustomerName">-</div>
                </div>

                <div class="row mb-3">
                    <div class="col-6">
                        <strong>Số tiền:</strong>
                    </div>
                    <div class="col-6" id="modalAmount" style="color: #28a745; font-weight: 700;">-</div>
                </div>

                <div class="row mb-3">
                    <div class="col-6">
                        <strong>Mã giao dịch:</strong>
                    </div>
                    <div class="col-6" id="modalTransactionId">-</div>
                </div>

                <div class="row mb-3">
                    <div class="col-6">
                        <strong>Ngày thanh toán:</strong>
                    </div>
                    <div class="col-6" id="modalPaymentDate">-</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                <a id="viewDetailLink" href="#" class="btn btn-primary" style="background: #f36100; border: none;">Xem chi tiết đầy đủ</a>
            </div>
        </div>
    </div>
</div>

<script>
    function viewDetails(paymentId, customerName, amount, transactionId, paymentDate) {
        // Cập nhật thông tin modal
        document.getElementById('modalCustomerName').textContent = customerName;
        document.getElementById('modalAmount').textContent = amount + '₫';
        document.getElementById('modalTransactionId').textContent = transactionId;
        document.getElementById('modalPaymentDate').textContent = paymentDate;
        document.getElementById('viewDetailLink').href = '/admin/payment/details/' + paymentId;

        // Mở modal
        $('#detailsModal').modal('show');
    }
</script>
