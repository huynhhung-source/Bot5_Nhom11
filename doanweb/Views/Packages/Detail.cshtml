@model doanweb.Models.Package

@{
    ViewData["Title"] = $"Chi tiết - {Model?.PackageName}";
}

<!-- Breadcrumb Begin -->
<section class="breadcrumb-section set-bg" data-setbg="~/img/breadcrumb-bg.jpg" style="background-image: linear-gradient(rgba(0,0,0,0.8), rgba(0,0,0,0.8)), url('~/img/breadcrumb-bg.jpg'); background-size: cover; background-position: center; background-attachment: fixed; background-color: #151515; position: relative; min-height: 300px; display: flex; align-items: center; justify-content: center;">
    <div class="container" style="position: relative; z-index: 2;">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="breadcrumb-text">
                    <h2 style="color: white; font-size: 48px; font-weight: 600; text-transform: uppercase;">@Model?.PackageName</h2>
                    <div class="bt-option" style="margin-top: 20px;">
                        <a href="/" style="color: white; font-size: 16px; font-weight: 700; display: inline-block; margin-right: 20px;">Trang chủ</a>
                        <a href="/packages/online" style="color: white; font-size: 16px; font-weight: 700; display: inline-block; margin-right: 20px;">Gói tập</a>
                        <span style="color: #f36100; font-size: 16px; font-weight: 700;">Chi tiết gói</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Breadcrumb End -->

<!-- Package Detail Section Begin -->
<section class="package-detail-section spad" style="background: #151515; padding: 100px 0;">
    <div class="container">
        <div class="row">
            <!-- Package Information -->
            <div class="col-lg-8">
                <!-- Package Image/Header -->
                <div class="package-header" style="background: linear-gradient(135deg, #f36100, #dc143c); padding: 60px 40px; border-radius: 10px; margin-bottom: 40px; text-align: center; color: white;">
                    <h1 style="font-size: 48px; font-weight: 700; margin-bottom: 20px;">@Model?.PackageName</h1>
                    <div style="font-size: 24px; margin-bottom: 20px;">
                        <span style="font-weight: 600;">Thời hạn:</span>
                        <span>@(Model?.DurationDays > 0 ? (Model.DurationDays / 30) : 0) tháng (@Model?.DurationDays ngày)</span>
                    </div>
                    <div style="font-size: 48px; font-weight: 700; color: white;">
                        @Model?.Price.ToString("N0")₫
                    </div>
                </div>

                <!-- Package Image Display -->
                @if (!string.IsNullOrEmpty(Model?.ImageUrl))
                {
                    <div style="margin-bottom: 40px; overflow: hidden; border-radius: 10px; box-shadow: 0 10px 30px rgba(243, 97, 0, 0.3);">
                        <img src="@Model.ImageUrl" alt="@Model?.PackageName" 
                             style="width: 100%; height: auto; max-height: 400px; object-fit: cover; display: block;" 
                             onerror="this.style.display='none'" />
                    </div>
                }

                <!-- Package Description -->
                <div class="package-description" style="background: #222222; padding: 40px; border-radius: 10px; margin-bottom: 40px; border-left: 4px solid #f36100;">
                    <h2 style="color: white; font-size: 24px; font-weight: 700; margin-bottom: 20px;">📋 Mô Tả Gói Tập</h2>
                    <p style="color: #c4c4c4; font-size: 16px; line-height: 1.8;">
                        @Model?.Description
                    </p>
                </div>

                <!-- Package Features -->
                <div class="package-features" style="background: #222222; padding: 40px; border-radius: 10px; margin-bottom: 40px; border-left: 4px solid #f36100;">
                    <h2 style="color: white; font-size: 24px; font-weight: 700; margin-bottom: 30px;">✅ Tính Năng Bao Gồm</h2>
                    <div class="features-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                        @if (!string.IsNullOrEmpty(Model?.Features))
                        {
                            @foreach (var feature in Model.Features.Split(','))
                            {
                                <div style="display: flex; align-items: center;">
                                    <i class="fa fa-check-circle" style="color: #f36100; font-size: 20px; margin-right: 15px;"></i>
                                    <span style="color: #c4c4c4; font-size: 16px;">@feature.Trim()</span>
                                </div>
                            }
                        }
                    </div>
                </div>

                <!-- Rules & Guidelines -->
                <div class="package-rules" style="background: #222222; padding: 40px; border-radius: 10px; margin-bottom: 40px; border-left: 4px solid #f36100;">
                    <h2 style="color: white; font-size: 24px; font-weight: 700; margin-bottom: 20px;">📌 Nội Quy</h2>
                    <ul style="list-style: none; padding: 0;">
                        <li style="color: #c4c4c4; font-size: 16px; line-height: 2; padding: 10px 0;">
                            <i class="fa fa-circle" style="color: #f36100; margin-right: 10px; font-size: 8px;"></i>
                            Thành viên phải tuân thủ quy định của phòng tập
                        </li>
                        <li style="color: #c4c4c4; font-size: 16px; line-height: 2; padding: 10px 0;">
                            <i class="fa fa-circle" style="color: #f36100; margin-right: 10px; font-size: 8px;"></i>
                            Không được quay phim, chụp ảnh mà không được phép
                        </li>
                        <li style="color: #c4c4c4; font-size: 16px; line-height: 2; padding: 10px 0;">
                            <i class="fa fa-circle" style="color: #f36100; margin-right: 10px; font-size: 8px;"></i>
                            Giữ vệ sinh và trật tự chung
                        </li>
                        <li style="color: #c4c4c4; font-size: 16px; line-height: 2; padding: 10px 0;">
                            <i class="fa fa-circle" style="color: #f36100; margin-right: 10px; font-size: 8px;"></i>
                            Không được mang đồ ăn bẩn vào phòng tập
                        </li>
                        <li style="color: #c4c4c4; font-size: 16px; line-height: 2; padding: 10px 0;">
                            <i class="fa fa-circle" style="color: #f36100; margin-right: 10px; font-size: 8px;"></i>
                            Hoàn trả thẻ thành viên khi hết hạn
                        </li>
                        <li style="color: #c4c4c4; font-size: 16px; line-height: 2; padding: 10px 0;">
                            <i class="fa fa-circle" style="color: #f36100; margin-right: 10px; font-size: 8px;"></i>
                            Phí cấp lại thẻ: 50.000₫
                        </li>
                    </ul>
                </div>

                <!-- Important Notes -->
                <div class="package-notes" style="background: #222222; padding: 40px; border-radius: 10px; border-left: 4px solid #f36100;">
                    <h2 style="color: white; font-size: 24px; font-weight: 700; margin-bottom: 20px;">⚠️ Những Điều Cần Lưu Ý</h2>
                    <ul style="list-style: none; padding: 0;">
                        <li style="color: #c4c4c4; font-size: 16px; line-height: 2; padding: 10px 0;">
                            <i class="fa fa-lightbulb-o" style="color: #f36100; margin-right: 10px;"></i>
                            Hãy kiểm tra sức khỏe trước khi bắt đầu
                        </li>
                        <li style="color: #c4c4c4; font-size: 16px; line-height: 2; padding: 10px 0;">
                            <i class="fa fa-lightbulb-o" style="color: #f36100; margin-right: 10px;"></i>
                            Không được chuyển nhượng hay cho người khác sử dụng
                        </li>
                        <li style="color: #c4c4c4; font-size: 16px; line-height: 2; padding: 10px 0;">
                            <i class="fa fa-lightbulb-o" style="color: #f36100; margin-right: 10px;"></i>
                            Nếu muốn huỷ gói, liên hệ trực tiếp với quầy lễ tân
                        </li>
                        <li style="color: #c4c4c4; font-size: 16px; line-height: 2; padding: 10px 0;">
                            <i class="fa fa-lightbulb-o" style="color: #f36100; margin-right: 10px;"></i>
                            Không hoàn tiền nếu hết thời hạn gói
                        </li>
                        <li style="color: #c4c4c4; font-size: 16px; line-height: 2; padding: 10px 0;">
                            <i class="fa fa-lightbulb-o" style="color: #f36100; margin-right: 10px;"></i>
                            Tuân thủ đầy đủ hướng dẫn của huấn luyện viên
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Sidebar - Package Summary & Payment Button -->
            <div class="col-lg-4">
                <div style="background: #222222; padding: 40px; border-radius: 10px; position: sticky; top: 20px; border: 2px solid #f36100;">
                    <h3 style="color: white; font-size: 20px; font-weight: 700; margin-bottom: 30px; text-align: center;">Tóm Tắt Gói Tập</h3>

                    <!-- Summary Details -->
                    <div style="margin-bottom: 30px; padding-bottom: 30px; border-bottom: 1px solid #464646;">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
                            <span style="color: #c4c4c4;">Tên gói:</span>
                            <span style="color: #f36100; font-weight: 600;">@Model?.PackageName</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
                            <span style="color: #c4c4c4;">Thời hạn:</span>
                            <span style="color: #f36100; font-weight: 600;">@(Model?.DurationDays > 0 ? (Model.DurationDays / 30) : 0) tháng</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
                            <span style="color: #c4c4c4;">Loại gói:</span>
                            <span style="color: #f36100; font-weight: 600;">@(Model?.PackageType ?? "Combo")</span>
                        </div>
                        @if (Model?.MaxSessions > 0)
                        {
                            <div style="display: flex; justify-content: space-between;">
                                <span style="color: #c4c4c4;">Số buổi:</span>
                                <span style="color: #f36100; font-weight: 600;">@Model?.MaxSessions buổi</span>
                            </div>
                        }
                    </div>

                    <!-- Price -->
                    <div style="text-align: center; margin-bottom: 30px;">
                        <div style="color: #c4c4c4; font-size: 14px; margin-bottom: 10px;">Giá:</div>
                        <div style="font-size: 48px; color: #f36100; font-weight: 700;">
                            @Model?.Price.ToString("N0")₫
                        </div>
                    </div>

                    <!-- Payment Button -->
                    <button type="button" class="btn btn-lg" style="width: 100%; background: #f36100; color: white; border: none; padding: 15px; font-size: 16px; font-weight: 700; border-radius: 5px; text-transform: uppercase; margin-bottom: 15px; cursor: pointer; transition: all 0.3s;" onclick="redirectToPayment(@Model?.PackageId)">
                        💳 Tiến Hành Thanh Toán
                    </button>

                    <!-- Continue Shopping Button -->
                    <a href="/packages/online" class="btn btn-lg" style="width: 100%; background: transparent; color: #f36100; border: 2px solid #f36100; padding: 13px; font-size: 16px; font-weight: 700; border-radius: 5px; text-transform: uppercase; text-align: center; display: block; cursor: pointer; transition: all 0.3s; text-decoration: none;">
                        ← Quay Lại Danh Sách
                    </a>

                    <!-- Contact Info -->
                    <div style="background: #151515; padding: 20px; border-radius: 5px; margin-top: 30px;">
                        <h4 style="color: white; font-size: 14px; font-weight: 700; margin-bottom: 15px;">📞 Liên Hệ Hỗ Trợ</h4>
                        <p style="color: #c4c4c4; font-size: 14px; margin-bottom: 8px;">
                            <i class="fa fa-phone" style="color: #f36100; margin-right: 8px;"></i>
                            <strong>125-711-811</strong>
                        </p>
                        <p style="color: #c4c4c4; font-size: 14px; margin-bottom: 8px;">
                            <i class="fa fa-envelope" style="color: #f36100; margin-right: 8px;"></i>
                            <strong>Support.gymcenter@gmail.com</strong>
                        </p>
                        <p style="color: #c4c4c4; font-size: 14px;">
                            <i class="fa fa-clock-o" style="color: #f36100; margin-right: 8px;"></i>
                            <strong>24/7 Hỗ Trợ</strong>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Package Detail Section End -->

<style>
    .btn-lg:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(243, 97, 0, 0.3);
    }

    .btn-lg:active {
        transform: translateY(0);
    }

    .package-rules ul li,
    .package-notes ul li {
        transition: all 0.3s ease;
    }

    .package-rules ul li:hover,
    .package-notes ul li:hover {
        padding-left: 20px;
        color: #f36100;
    }
</style>

<script>
    function redirectToPayment(packageId) {
        // Kiểm tra xem user đã đăng nhập chưa
        var userEmail = '@(Context.Session.GetString("UserEmail") ?? "")';
        
        if (!userEmail || userEmail === '') {
            // Chưa đăng nhập, redirect đến login
            window.location.href = '/Customer/Account/Login?returnUrl=/Packages/Detail/' + packageId;
        } else {
            // Đã đăng nhập, chuyển đến trang thanh toán
            window.location.href = '/Payment/Checkout?packageId=' + packageId;
        }
    }
</script>
