@model ProfileViewModel

@{
    ViewData["Title"] = "H? S? Cá Nhân";
}

<!-- Breadcrumb Begin -->
<section class="breadcrumb-section set-bg" data-setbg="~/img/breadcrumb-bg.jpg" style="background-image: linear-gradient(rgba(0,0,0,0.8), rgba(0,0,0,0.8)), url('~/img/breadcrumb-bg.jpg'); background-size: cover; background-position: center; background-attachment: fixed; background-color: #151515; position: relative; min-height: 300px; display: flex; align-items: center; justify-content: center;">
    <div class="container" style="position: relative; z-index: 2;">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="breadcrumb-text">
                    <h2 style="color: white; font-size: 48px; font-weight: 600; text-transform: uppercase;">H? S? Cá Nhân</h2>
                    <div class="bt-option" style="margin-top: 20px;">
                        <a href="/" style="color: white; font-size: 16px; font-weight: 700; display: inline-block; margin-right: 20px;">Trang ch?</a>
                        <span style="color: #f36100; font-size: 16px; font-weight: 700;">H? S? Cá Nhân</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Breadcrumb End -->

<!-- Profile Section Begin -->
<section class="pricing-section spad" style="background: #151515; padding: 100px 0;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div style="background: white; padding: 50px; border-radius: 10px; box-shadow: 0 5px 15px rgba(0,0,0,0.1);">
                    <h2 style="text-align: center; margin-bottom: 30px; color: #111111;">C?p Nh?t Thông Tin Cá Nhân</h2>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div style="background: #d4edda; color: #155724; padding: 15px; border-radius: 5px; margin-bottom: 20px; border: 1px solid #c3e6cb;">
                            <i class="fa fa-check-circle"></i> @TempData["SuccessMessage"]
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div style="background: #f8d7da; color: #721c24; padding: 15px; border-radius: 5px; margin-bottom: 20px; border: 1px solid #f5c6cb;">
                            <strong><i class="fa fa-exclamation-circle"></i> L?i:</strong>
                            <ul style="margin-top: 10px;">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    }

                    <form method="post" action="/customer/account/profile">
                        @Html.AntiForgeryToken()

                        <!-- H? tên -->
                        <div class="form-group" style="margin-bottom: 20px;">
                            <label style="font-weight: 600; color: #333; display: block; margin-bottom: 8px;">H? tên *</label>
                            <input type="text" name="FullName" class="form-control" placeholder="Nh?p h? tên c?a b?n" 
                                   style="width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 5px; font-size: 14px;"
                                   value="@Model?.FullName" required />
                            @if (ViewData.ModelState.TryGetValue("FullName", out var fullNameErrors))
                            {
                                @foreach (var error in fullNameErrors.Errors)
                                {
                                    <span style="color: #dc3545; font-size: 12px;">@error.ErrorMessage</span>
                                }
                            }
                        </div>

                        <!-- Email -->
                        <div class="form-group" style="margin-bottom: 20px;">
                            <label style="font-weight: 600; color: #333; display: block; margin-bottom: 8px;">Email *</label>
                            <input type="email" name="Email" class="form-control" placeholder="Nh?p email c?a b?n" 
                                   style="width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 5px; font-size: 14px;"
                                   value="@Model?.Email" required />
                            @if (ViewData.ModelState.TryGetValue("Email", out var emailErrors))
                            {
                                @foreach (var error in emailErrors.Errors)
                                {
                                    <span style="color: #dc3545; font-size: 12px;">@error.ErrorMessage</span>
                                }
                            }
                        </div>

                        <!-- S? ?i?n tho?i -->
                        <div class="form-group" style="margin-bottom: 20px;">
                            <label style="font-weight: 600; color: #333; display: block; margin-bottom: 8px;">S? ?i?n tho?i *</label>
                            <input type="tel" name="PhoneNumber" class="form-control" placeholder="Nh?p s? ?i?n tho?i" 
                                   style="width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 5px; font-size: 14px;"
                                   value="@Model?.PhoneNumber" required />
                            @if (ViewData.ModelState.TryGetValue("PhoneNumber", out var phoneErrors))
                            {
                                @foreach (var error in phoneErrors.Errors)
                                {
                                    <span style="color: #dc3545; font-size: 12px;">@error.ErrorMessage</span>
                                }
                            }
                        </div>

                        <!-- Ngày sinh -->
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group" style="margin-bottom: 20px;">
                                    <label style="font-weight: 600; color: #333; display: block; margin-bottom: 8px;">Ngày sinh</label>
                                    <input type="date" name="DateOfBirth" class="form-control" 
                                           style="width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 5px; font-size: 14px;"
                                           value="@(Model?.DateOfBirth != null ? Model.DateOfBirth.Value.ToString("yyyy-MM-dd") : "")" />
                                </div>
                            </div>

                            <!-- Gi?i tính -->
                            <div class="col-md-6">
                                <div class="form-group" style="margin-bottom: 20px;">
                                    <label style="font-weight: 600; color: #333; display: block; margin-bottom: 8px;">Gi?i tính</label>
                                    <select name="Gender" class="form-control" id="genderSelect"
                                            style="width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 5px; font-size: 14px;">
                                        <option value="">-- Ch?n gi?i tính --</option>
                                        <option value="Male">Nam</option>
                                        <option value="Female">N?</option>
                                        <option value="Other">Khác</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- ??a ch? -->
                        <div class="form-group" style="margin-bottom: 20px;">
                            <label style="font-weight: 600; color: #333; display: block; margin-bottom: 8px;">??a ch?</label>
                            <textarea name="Address" class="form-control" rows="3" placeholder="Nh?p ??a ch? c?a b?n" 
                                      style="width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 5px; font-size: 14px;">@Model?.Address</textarea>
                        </div>

                        <!-- Nút C?p nh?t -->
                        <button type="submit" class="primary-btn" style="width: 100%; background: #f36100; color: white; border: none; padding: 15px; border-radius: 5px; font-size: 16px; font-weight: 700; text-transform: uppercase; cursor: pointer; margin-bottom: 15px;">
                            <i class="fa fa-save"></i> C?p Nh?t Thông Tin
                        </button>

                        <!-- Nút Quay l?i -->
                        <a href="/" class="primary-btn" style="width: 100%; background: transparent; color: #f36100; border: 2px solid #f36100; padding: 13px; border-radius: 5px; font-size: 16px; font-weight: 700; text-transform: uppercase; text-align: center; display: block; text-decoration: none;">
                            ? Quay L?i Trang Ch?
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Profile Section End -->

<style>
    .form-control:focus {
        border-color: #f36100;
        box-shadow: 0 0 0 0.2rem rgba(243, 97, 0, 0.25);
    }

    .primary-btn:hover {
        background-color: #e55a00 !important;
        border-color: #e55a00 !important;
    }
</style>

<script>
    // Set gender value
    var gender = '@Model?.Gender';
    if (gender) {
        document.getElementById('genderSelect').value = gender;
    }
</script>
