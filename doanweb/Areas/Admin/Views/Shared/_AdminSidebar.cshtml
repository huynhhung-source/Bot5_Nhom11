<!-- Admin Sidebar Navigation -->
<nav class="admin-sidebar" id="adminSidebar">
    <div class="sidebar-header">
        <h5 style="margin: 0; color: #f36100; font-weight: 700;">
            <i class="fa fa-shield"></i> Admin Panel
        </h5>
        <button class="btn btn-sm btn-link text-white d-md-none" onclick="toggleSidebar()" style="float: right;">
            <i class="fa fa-times"></i>
        </button>
    </div>

    <ul class="nav flex-column">
        <!-- Dashboard -->
        <li class="nav-item">
            <a class="nav-link" href="/admin/home/index">
                <i class="fa fa-dashboard"></i> Dashboard
            </a>
        </li>

        <!-- Quản lý Người dùng -->
        <li class="nav-item">
            <a class="nav-link" href="/admin/user/index">
                <i class="fa fa-users"></i> Quản lý Người dùng
            </a>
        </li>

        <!-- Quản lý Gói Tập -->
        <li class="nav-item">
            <a class="nav-link" href="/admin/package/index">
                <i class="fa fa-shopping-bag"></i> Quản lý Gói Tập
            </a>
        </li>

        <!-- Thêm mục quản lý khác -->
        <li class="nav-item">
            <a class="nav-link" href="#">
                <i class="fa fa-calendar"></i> Quản lý Lớp Tập
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link" href="#">
                <i class="fa fa-credit-card"></i> Quản lý Thanh toán
            </a>
        </li>

        <hr style="background-color: rgba(255,255,255,0.2); margin: 10px 0;">

        <!-- Báo cáo -->
        <li class="nav-item">
            <a class="nav-link" href="#">
                <i class="fa fa-bar-chart"></i> Báo cáo
            </a>
        </li>

        <!-- Cài đặt -->
        <li class="nav-item">
            <a class="nav-link" href="#">
                <i class="fa fa-cog"></i> Cài đặt
            </a>
        </li>

        <!-- Đăng xuất -->
        <li class="nav-item">
            <form method="post" action="/customer/account/logout" style="display: inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="nav-link" style="border: none; background: none; width: 100%; text-align: left;">
                    <i class="fa fa-sign-out"></i> Đăng xuất
                </button>
            </form>
        </li>
    </ul>
</nav>

<style>
    .admin-sidebar {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
        color: white;
        padding: 20px 0;
        height: 100vh;
        position: fixed;
        left: 0;
        top: 0;
        width: 250px;
        overflow-y: auto;
        z-index: 1000;
    }

    .sidebar-header {
        padding: 20px;
        border-bottom: 2px solid rgba(255, 255, 255, 0.1);
        margin-bottom: 20px;
    }

    .admin-sidebar .nav-link {
        color: rgba(255, 255, 255, 0.8);
        padding: 12px 20px;
        transition: all 0.3s ease;
        border-left: 4px solid transparent;
    }

    .admin-sidebar .nav-link:hover {
        color: #f36100;
        background-color: rgba(243, 97, 0, 0.1);
        border-left-color: #f36100;
        padding-left: 25px;
    }

    .admin-sidebar .nav-link.active {
        color: #f36100;
        background-color: rgba(243, 97, 0, 0.1);
        border-left-color: #f36100;
        font-weight: 600;
    }

    .admin-sidebar .nav-link i {
        margin-right: 10px;
        width: 20px;
    }

    /* Adjust main content for sidebar */
    body.admin-body {
        margin-left: 250px;
    }

    .admin-sidebar::-webkit-scrollbar {
        width: 6px;
    }

    .admin-sidebar::-webkit-scrollbar-track {
        background: rgba(255, 255, 255, 0.1);
    }

    .admin-sidebar::-webkit-scrollbar-thumb {
        background: rgba(243, 97, 0, 0.5);
        border-radius: 3px;
    }

    .admin-sidebar::-webkit-scrollbar-thumb:hover {
        background: rgba(243, 97, 0, 0.8);
    }
</style>

<script>
    function toggleSidebar() {
        const sidebar = document.getElementById('adminSidebar');
        sidebar.classList.toggle('show');
    }

    // Highlight active menu item
    document.addEventListener('DOMContentLoaded', function() {
        const currentPath = window.location.pathname.toLowerCase();
        const navLinks = document.querySelectorAll('.admin-sidebar .nav-link');
        
        navLinks.forEach(link => {
            const href = link.getAttribute('href');
            if (href && currentPath.includes(href.toLowerCase())) {
                link.classList.add('active');
            }
        });
    });
</script>
