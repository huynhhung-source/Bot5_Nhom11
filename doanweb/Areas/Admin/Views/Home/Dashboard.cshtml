@model doanweb.Areas.Admin.Controllers.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid mt-5">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 style="color: #111111; margin: 0; font-weight: 700;">
                        <i class="fa fa-dashboard"></i> Dashboard Hệ Thống
                    </h2>
                    <small class="text-muted">Theo dõi hoạt động hệ thống Gym</small>
                </div>
                <div>
                    <button class="btn btn-outline-secondary btn-sm" onclick="location.reload()">
                        <i class="fa fa-refresh"></i> Làm mới
                    </button>
                </div>
            </div>
            <hr style="border-top: 2px solid #f36100; margin: 15px 0;">
        </div>
    </div>

    <!-- Main Statistics Row -->
    <div class="row mb-4">
        <!-- Card 1: Tổng Người Dùng -->
        <div class="col-lg-6 col-md-12 mb-3">
            <div class="card border-0 h-100" style="box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div style="flex: 1;">
                            <h6 class="text-uppercase text-muted mb-2" style="font-size: 12px; letter-spacing: 1px;">
                                <i class="fa fa-users"></i> Người Dùng
                            </h6>
                            <h2 style="color: #007bff; margin: 0; font-weight: 700;">@Model.TotalUsers</h2>
                            <div style="margin-top: 10px;">
                                <span class="badge bg-success">
                                    <i class="fa fa-check-circle"></i> @Model.ActiveUsers hoạt động
                                </span>
                                <span class="badge bg-danger">
                                    <i class="fa fa-times-circle"></i> @(Model.TotalUsers - Model.ActiveUsers) không hoạt động
                                </span>
                            </div>
                        </div>
                        <div style="font-size: 50px; color: #007bff; opacity: 0.15;">
                            <i class="fa fa-users"></i>
                        </div>
                    </div>
                    <div style="margin-top: 15px; padding-top: 15px; border-top: 1px solid #eee;">
                        <a href="/admin/user/index" class="btn btn-sm btn-primary" style="background: #007bff; border: none;">
                            <i class="fa fa-arrow-right"></i> Quản Lý Người Dùng
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Doanh Thu -->
        <div class="col-lg-6 col-md-12 mb-3">
            <div class="card border-0 h-100" style="box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div style="flex: 1;">
                            <h6 class="text-uppercase text-muted mb-2" style="font-size: 12px; letter-spacing: 1px;">
                                <i class="fa fa-money"></i> Tổng Doanh Thu
                            </h6>
                            <h2 style="color: #f36100; margin: 0; font-weight: 700;">@Model.TotalRevenue.ToString("N0")</h2>
                            <div style="margin-top: 10px;">
                                <span class="badge" style="background: #f36100; color: white;">
                                    <i class="fa fa-credit-card"></i> Từ @Model.TotalPayments giao dịch
                                </span>
                            </div>
                        </div>
                        <div style="font-size: 50px; color: #f36100; opacity: 0.15;">
                            <i class="fa fa-money"></i>
                        </div>
                    </div>
                    <div style="margin-top: 15px; padding-top: 15px; border-top: 1px solid #eee;">
                        <a href="#" class="btn btn-sm" style="background: #f36100; border: none; color: white;">
                            <i class="fa fa-arrow-right"></i> Xem Chi Tiết
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Secondary Statistics -->
    <div class="row mb-4">
        <!-- Gói Tập -->
        <div class="col-md-4 mb-3">
            <div class="card border-0" style="box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                <div class="card-body">
                    <h6 class="text-uppercase text-muted mb-3" style="font-size: 12px; letter-spacing: 1px;">
                        <i class="fa fa-shopping-bag"></i> Gói Tập
                    </h6>
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h3 style="color: #28a745; margin: 0; font-weight: 700;">@Model.TotalPackages</h3>
                            <small class="text-muted">Gói hiệu động</small>
                        </div>
                        <div style="font-size: 40px; color: #28a745; opacity: 0.2;">
                            <i class="fa fa-shopping-bag"></i>
                        </div>
                    </div>
                    <a href="/admin/package/index" class="btn btn-sm btn-success mt-3" style="width: 100%; background: #28a745; border: none;">
                        <i class="fa fa-list"></i> Quản Lý Gói Tập
                    </a>
                </div>
            </div>
        </div>

        <!-- Đăng Ký -->
        <div class="col-md-4 mb-3">
            <div class="card border-0" style="box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                <div class="card-body">
                    <h6 class="text-uppercase text-muted mb-3" style="font-size: 12px; letter-spacing: 1px;">
                        <i class="fa fa-check-square"></i> Đăng Ký
                    </h6>
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h3 style="color: #ffc107; margin: 0; font-weight: 700;">@Model.ActiveSubscriptions</h3>
                            <small class="text-muted">Đang hoạt động (/@Model.TotalSubscriptions)</small>
                        </div>
                        <div style="font-size: 40px; color: #ffc107; opacity: 0.2;">
                            <i class="fa fa-check-square"></i>
                        </div>
                    </div>
                    <div class="progress mt-3" style="height: 8px;">
                        <div class="progress-bar bg-warning" role="progressbar" 
                             style="width: @((Model.TotalSubscriptions > 0 ? (Model.ActiveSubscriptions * 100 / Model.TotalSubscriptions) : 0))%">
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Lớp Tập -->
        <div class="col-md-4 mb-3">
            <div class="card border-0" style="box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                <div class="card-body">
                    <h6 class="text-uppercase text-muted mb-3" style="font-size: 12px; letter-spacing: 1px;">
                        <i class="fa fa-dumbbell"></i> Lớp Tập
                    </h6>
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h3 style="color: #e91e63; margin: 0; font-weight: 700;">@Model.TotalClasses</h3>
                            <small class="text-muted">Tổng lớp tập</small>
                        </div>
                        <div style="font-size: 40px; color: #e91e63; opacity: 0.2;">
                            <i class="fa fa-dumbbell"></i>
                        </div>
                    </div>
                    <a href="#" class="btn btn-sm mt-3" style="width: 100%; background: #e91e63; border: none; color: white;">
                        <i class="fa fa-list"></i> Quản Lý Lớp
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Access Section -->
    <div class="row">
        <div class="col-md-12">
            <h5 class="mb-3"><i class="fa fa-lightning"></i> Truy Cập Nhanh</h5>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <div class="card border-0" style="box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                <div class="card-header bg-light border-bottom">
                    <h6 class="mb-0"><i class="fa fa-plus-circle"></i> Thêm Mới</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <a href="/admin/user/create" class="btn btn-block btn-outline-primary btn-sm" style="width: 100%;">
                                <i class="fa fa-user-plus"></i> Thêm Người Dùng
                            </a>
                        </div>
                        <div class="col-md-6 mb-2">
                            <a href="/admin/package/create" class="btn btn-block btn-outline-success btn-sm" style="width: 100%;">
                                <i class="fa fa-plus"></i> Thêm Gói Tập
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card border-0" style="box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                <div class="card-header bg-light border-bottom">
                    <h6 class="mb-0"><i class="fa fa-list"></i> Danh Sách</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <a href="/admin/user/index" class="btn btn-block btn-outline-info btn-sm" style="width: 100%;">
                                <i class="fa fa-users"></i> Người Dùng
                            </a>
                        </div>
                        <div class="col-md-6 mb-2">
                            <a href="/admin/package/index" class="btn btn-block btn-outline-warning btn-sm" style="width: 100%;">
                                <i class="fa fa-shopping-bag"></i> Gói Tập
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        transition: all 0.3s ease;
    }

    .card:hover {
        transform: translateY(-3px);
        box-shadow: 0 5px 20px rgba(0,0,0,0.15) !important;
    }

    .btn:hover {
        transform: scale(1.02);
    }

    .progress {
        background-color: #f0f0f0;
    }

    h6 {
        color: #333;
        font-weight: 600;
    }

    h2 {
        font-size: 32px;
    }

    .badge {
        padding: 6px 10px;
        font-size: 12px;
        font-weight: 600;
    }
</style>
