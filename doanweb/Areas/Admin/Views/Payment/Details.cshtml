@model doanweb.Models.Payment

@{
    ViewData["Title"] = "Chi Ti?t Thanh Toán";
    var subscription = ViewBag.Subscription as doanweb.Models.Subscription;
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2 style="color: #333;">
                <i class="fas fa-receipt" style="color: #f36100; margin-right: 10px;"></i>
                Chi Ti?t Thanh Toán #@Model?.PaymentId
            </h2>
        </div>
        <div class="col-md-4 text-right">
            <a href="/admin/payment/index" class="btn btn-secondary">
                <i class="fa fa-arrow-left"></i> Quay L?i
            </a>
        </div>
    </div>

    <div class="row">
        <!-- Thông tin thanh toán -->
        <div class="col-md-6">
            <div class="card" style="box-shadow: 0 2px 8px rgba(0,0,0,0.1); margin-bottom: 20px;">
                <div class="card-header bg-dark text-white">
                    <h5 style="margin: 0;">?? Thông Tin Thanh Toán</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-6">
                            <strong>Mã Thanh Toán:</strong>
                        </div>
                        <div class="col-6">
                            <span class="badge bg-secondary">@Model?.PaymentId</span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6">
                            <strong>S? Ti?n:</strong>
                        </div>
                        <div class="col-6" style="color: #28a745; font-weight: 700; font-size: 18px;">
                            @Model?.Amount.ToString("N0")?
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6">
                            <strong>Ph??ng Th?c:</strong>
                        </div>
                        <div class="col-6">
                            <span class="badge bg-info">@Model?.PaymentMethod</span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6">
                            <strong>Mã Giao D?ch:</strong>
                        </div>
                        <div class="col-6">
                            <code>@Model?.TransactionId</code>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6">
                            <strong>Ngày Thanh Toán:</strong>
                        </div>
                        <div class="col-6">
                            @Model?.PaymentDate.ToString("dd/MM/yyyy HH:mm:ss")
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6">
                            <strong>Tr?ng Thái:</strong>
                        </div>
                        <div class="col-6">
                            @if (Model?.Status == "Success")
                            {
                                <span class="badge bg-success">
                                    <i class="fa fa-check-circle"></i> Thành Công
                                </span>
                            }
                            else if (Model?.Status == "Failed")
                            {
                                <span class="badge bg-danger">
                                    <i class="fa fa-times-circle"></i> Th?t B?i
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning">
                                    <i class="fa fa-hourglass-half"></i> Ch? X? Lý
                                </span>
                            }
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6">
                            <strong>Mô T?:</strong>
                        </div>
                        <div class="col-6">
                            @Model?.Description
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model?.Notes))
                    {
                        <div class="row mb-3">
                            <div class="col-6">
                                <strong>Ghi Chú:</strong>
                            </div>
                            <div class="col-6">
                                @Model?.Notes
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Thông tin khách hàng -->
        <div class="col-md-6">
            <div class="card" style="box-shadow: 0 2px 8px rgba(0,0,0,0.1); margin-bottom: 20px;">
                <div class="card-header bg-dark text-white">
                    <h5 style="margin: 0;">?? Thông Tin Khách Hàng</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-6">
                            <strong>ID Khách Hàng:</strong>
                        </div>
                        <div class="col-6">
                            <span class="badge bg-secondary">@Model?.User?.UserId</span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6">
                            <strong>H? Tên:</strong>
                        </div>
                        <div class="col-6">
                            @Model?.User?.FullName
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6">
                            <strong>Email:</strong>
                        </div>
                        <div class="col-6">
                            <a href="mailto:@Model?.User?.Email">@Model?.User?.Email</a>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6">
                            <strong>S? ?i?n Tho?i:</strong>
                        </div>
                        <div class="col-6">
                            <a href="tel:@Model?.User?.PhoneNumber">@Model?.User?.PhoneNumber</a>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6">
                            <strong>??a Ch?:</strong>
                        </div>
                        <div class="col-6">
                            @Model?.User?.Address
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6">
                            <strong>Tr?ng Thái:</strong>
                        </div>
                        <div class="col-6">
                            @if (Model?.User?.Status == "Active")
                            {
                                <span class="badge bg-success">Ho?t ??ng</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">B? Khóa</span>
                            }
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6">
                            <strong>Ngày T?o:</strong>
                        </div>
                        <div class="col-6">
                            @Model?.User?.CreatedDate.ToString("dd/MM/yyyy")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Thông tin gói t?p -->
    @if (subscription != null)
    {
        <div class="row">
            <div class="col-12">
                <div class="card" style="box-shadow: 0 2px 8px rgba(0,0,0,0.1); margin-bottom: 20px;">
                    <div class="card-header bg-dark text-white">
                        <h5 style="margin: 0;">?? Thông Tin Gói T?p</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-3">
                                <strong>Tên Gói:</strong>
                                <p style="color: #f36100; font-weight: 700;">@subscription?.Package?.PackageName</p>
                            </div>

                            <div class="col-md-3">
                                <strong>Th?i H?n:</strong>
                                <p>@(subscription?.Package?.DurationDays / 30) tháng (@subscription?.Package?.DurationDays ngày)</p>
                            </div>

                            <div class="col-md-3">
                                <strong>Ngày B?t ??u:</strong>
                                <p style="color: #28a745;">@subscription?.StartDate.ToString("dd/MM/yyyy")</p>
                            </div>

                            <div class="col-md-3">
                                <strong>Ngày K?t Thúc:</strong>
                                <p style="color: #dc3545;">@subscription?.EndDate.ToString("dd/MM/yyyy")</p>
                            </div>
                        </div>

                        <hr />

                        <div class="row">
                            <div class="col-md-3">
                                <strong>Tr?ng Thái:</strong>
                                <p>
                                    @if (subscription?.Status == "Active")
                                    {
                                        <span class="badge bg-success"><i class="fa fa-check-circle"></i> Ho?t ??ng</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger"><i class="fa fa-times-circle"></i> H?t h?n</span>
                                    }
                                </p>
                            </div>

                            <div class="col-md-3">
                                <strong>Ngày Kích Ho?t:</strong>
                                <p>@subscription?.ActivationDate.ToString("dd/MM/yyyy")</p>
                            </div>

                            <div class="col-md-3">
                                <strong>S? Bu?i S? D?ng:</strong>
                                <p>@subscription?.SessionsUsed / @subscription?.Package?.MaxSessions</p>
                            </div>

                            <div class="col-md-3">
                                <strong>S? Ngày Còn L?i:</strong>
                                <p style="color: #0066cc; font-weight: 700;">@subscription?.RemainingDays ngày</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Nút hành ??ng -->
    <div class="row">
        <div class="col-12">
            <a href="/admin/payment/index" class="btn btn-secondary">
                <i class="fa fa-arrow-left"></i> Quay L?i Danh Sách
            </a>
            <button type="button" class="btn btn-primary" onclick="window.print()" style="background: #333; border: none;">
                <i class="fa fa-print"></i> In Chi Ti?t
            </button>
        </div>
    </div>
</div>

<style>
    .card {
        border: none;
        border-radius: 8px;
    }

    @@media print {
        .btn, .btn-secondary, .btn-primary {
            display: none;
        }
    }
</style>
