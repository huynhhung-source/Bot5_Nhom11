        font-weight: 700;
        margin: 0 0 15px 0;
        color: white;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .page-header .breadcrumb {
        background: none;
        padding: 0;
        margin: 0;
    }

    .page-header .breadcrumb-item a {
