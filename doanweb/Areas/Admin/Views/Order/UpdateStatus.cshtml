@model doanweb.Models.Order

@{
    ViewData["Title"] = "Cập Nhật Trạng Thái Hóa Đơn";
}

<!-- Page Header -->
<div class="page-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-6">
                <h1>Cập Nhật Trạng Thái</h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/Admin/Home/Index">Dashboard</a></li>
                        <li class="breadcrumb-item"><a href="/Admin/Order/Index">Hóa Đơn</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Cập Nhật Trạng Thái</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Update Status Form -->
<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-body">
                    <div class="order-info-box">
                        <h4>Hóa Đơn #@Model.OrderId</h4>
                        <div class="info-item">
                            <span class="label">Khách Hàng:</span>
                            <span class="value">@Model.User?.FullName</span>
                        </div>
                        <div class="info-item">
                            <span class="label">Ngày Đặt:</span>
                            <span class="value">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="info-item">
                            <span class="label">Tổng Tiền:</span>
                            <span class="value price">@Model.TotalAmount.ToString("N0") đ</span>
                        </div>
                        <div class="info-item">
                            <span class="label">Trạng Thái Hiện Tại:</span>
                            <span class="value" >
                                @if (Model.Status == "Pending")
                                {
                                    <span class="badge badge-warning">Chờ Xử Lý</span>
                                }
                                else if (Model.Status == "Processing")
                                {
                                    <span class="badge badge-info">Đang Xử Lý</span>
                                }
                                else if (Model.Status == "Completed")
                                {
                                    <span class="badge badge-success">Hoàn Thành</span>
                                }
                                else if (Model.Status == "Cancelled")
                                {
                                    <span class="badge badge-danger">Hủy</span>
                                }
                            </span>
                        </div>
                    </div>

                    <form method="post" class="update-form">
                        <div class="form-group">
                            <label class="form-label">Cập Nhật Trạng Thái</label>
                            <div class="select-wrapper">
                                <select name="status" style="height: 50px" class="form-control form-select" required>
                                    <option value="">-- Chọn Trạng Thái --</option>
                                    <option value="Pending">Chờ Xử Lý</option>
                                    <option value="Processing">Đang Xử Lý</option>
                                    <option value="Completed">Hoàn Thành</option>
                                    <option value="Cancelled">Hủy</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary btn-save">
                                <i class="fa fa-save"></i> Lưu Thay Đổi
                            </button>
                            <a href="/Admin/Order/Details/@Model.OrderId" class="btn btn-secondary btn-cancel">
                                <i class="fa fa-times"></i> Hủy
                            </a>
                        </div>
                    </form>

                    <div class="status-guide">
                        <h5>Hướng Dẫn Trạng Thái</h5>
                        <ul>
                            <li><strong>Chờ Xử Lý:</strong> Đơn hàng vừa được đặt, chưa xác nhận</li>
                            <li><strong>Đang Xử Lý:</strong> Đơn hàng đã được xác nhận, đang chuẩn bị giao</li>
                            <li><strong>Hoàn Thành:</strong> Đơn hàng đã giao thành công cho khách hàng</li>
                            <li><strong>Hủy:</strong> Đơn hàng đã bị hủy</li>
                        </ul>
                    </div>

                    <script>
                        document.addEventListener('DOMContentLoaded', function() {
                            const currentStatus = '@Model.Status';
                            const select = document.querySelector('select[name="status"]');
                            if (select) {
                                select.value = currentStatus;
                            }
                        });
                    </script>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
