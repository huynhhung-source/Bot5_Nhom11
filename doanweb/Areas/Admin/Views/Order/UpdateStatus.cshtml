    }

    .form-actions {
        display: flex;
        gap: 12px;
        margin-bottom: 20px;
    }

    .btn {
        flex: 1;
        padding: 12px 20px;
        border: none;
        border-radius: 5px;
        font-weight: 600;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 14px;
    }

    .btn-primary {
        background-color: #f36100;
        color: white;
    }

    .btn-primary:hover {
        background-color: #d94d00;
        box-shadow: 0 4px 12px rgba(243, 97, 0, 0.3);
    }

    .btn-secondary {
        background-color: #e0e0e0;
        color: #333;
    }

    .btn-secondary:hover {
        background-color: #d0d0d0;
    }

    .status-guide {
        background: #f0f8ff;
        border: 1px solid #b3d9ff;
        border-radius: 6px;
        padding: 20px;
    }

    .status-guide h5 {
        font-weight: 700;
        color: #0056b3;
        margin-bottom: 15px;
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .status-guide ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .status-guide li {
        padding: 8px 0;
        color: #333;
        font-size: 13px;
        border-bottom: 1px solid #d9e7f7;
    }

    .status-guide li:last-child {
