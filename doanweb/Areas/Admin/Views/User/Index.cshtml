@model List<doanweb.Models.User>

@{
    ViewData["Title"] = "Quản lý Người Dùng";
}

<div class="container mt-5">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fa fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card" style="box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
        <div class="card-header bg-dark text-white">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h5 style="margin: 0;">Danh sách Người Dùng</h5>
                </div>
          
            </div>
        </div>
        <div class="card-body">
            @if (Model.Count == 0)
            {
                <div class="alert alert-info">
                    <i class="fa fa-info-circle"></i> Chưa có người dùng nào. <a href="/admin/user/create">Thêm người dùng</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th style="width: 4%;">ID</th>
                                <th style="width: 14%;">Tên Người Dùng</th>
                                <th style="width: 18%;">Email</th>
                                <th style="width: 10%;">Số Điện Thoại</th>
                                <th style="width: 8%;">Giới Tính</th>
                                <th style="width: 8%;">Quyền</th>
                                <th style="width: 9%;">Ngày Tạo</th>
                                <th style="width: 9%;">Trạng Thái</th>
                                <th style="width: 20%;">Hành Động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-secondary">@user.UserId</span>
                                    </td>
                                    <td>
                                        <strong>@user.FullName</strong>
                                    </td>
                                    <td>
                                        <span>@user.Email</span>
                                    </td>
                                    <td>
                                        <span>@user.PhoneNumber</span>
                                    </td>
                                    <td>
                                        @if (user.Gender == "Male")
                                        {
                                            <span class="badge bg-primary"><i class="fa fa-mars"></i> Nam</span>
                                        }
                                        else if (user.Gender == "Female")
                                        {
                                            <span class="badge bg-danger"><i class="fa fa-venus"></i> Nữ</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Khác</span>
                                        }
                                    </td>
                                    <td>
                                        @{
                                            var userRole = user.UserRoles?.FirstOrDefault();
                                            if (userRole?.Role?.RoleName == "Admin")
                                            {
                                                <span class="badge bg-danger" title="Admin">
                                                    <i class="fa fa-shield"></i> Admin
                                                </span>
                                            }
                                            else if (userRole?.Role?.RoleName == "Customer")
                                            {
                                                <span class="badge bg-info" title="Customer">
                                                    <i class="fa fa-user"></i> Customer
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">N/A</span>
                                            }
                                        }
                                    </td>
                                    <td>
                                        <small>@user.CreatedDate.ToString("dd/MM/yyyy")</small>
                                    </td>
                                    <td>
                                        @if (user.Status == "Active")
                                        {
                                            <span class="badge bg-success">
                                                <i class="fa fa-check-circle"></i> Hoạt động
                                            </span>
                                        }
                                        else if (user.Status == "Inactive")
                                        {
                                            <span class="badge bg-warning">
                                                <i class="fa fa-pause-circle"></i> Không hoạt động
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                <i class="fa fa-times-circle"></i> Bị khóa
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <a href="/admin/user/details/@user.UserId" class="btn btn-sm btn-info" title="Chi tiết">
                                            <i class="fa fa-eye"></i> Xem
                                        </a>
                                        <a href="/admin/user/edit/@user.UserId" class="btn btn-sm btn-warning" title="Chỉnh sửa">
                                            <i class="fa fa-edit"></i> Sửa
                                        </a>
                                        <button type="button" class="btn btn-sm btn-danger" onclick="deleteUser(@user.UserId, '@user.FullName')" title="Xóa">
                                            <i class="fa fa-trash"></i> Xóa
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: #f5f5f5;
        transition: background-color 0.3s;
    }

    .btn-sm {
        padding: 0.4rem 0.8rem;
        font-size: 0.875rem;
    }

    .badge {
        padding: 0.5rem 0.75rem;
        font-size: 0.85rem;
    }
</style>

@section Scripts {
    <script>
        function deleteUser(userId, userName) {
            if (confirm(`Bạn có chắc chắn muốn xóa người dùng "${userName}"?`)) {
                var deleteUrl = `/admin/user/delete`;
                console.log('Deleting user ID:', userId);
                
                fetch(deleteUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ id: userId })
                })
                .then(response => {
                    console.log('Response status:', response.status);
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    console.log('Response data:', data);
                    if (data.success) {
                        alert(data.message);
                        location.reload();
                    } else {
                        alert('Lỗi: ' + data.message);
                    }
                })
                .catch(error => {
                    console.error('Fetch error:', error);
                    alert('Lỗi khi gửi yêu cầu xóa: ' + error.message);
                });
            }
        }
    </script>
}
