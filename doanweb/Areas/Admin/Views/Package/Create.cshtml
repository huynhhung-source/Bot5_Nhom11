@model doanweb.Models.Package

@{
    ViewData["Title"] = "Thêm Gói Tập";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card" style="box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                <div class="card-header bg-dark text-white">
                    <h5 style="margin: 0;">Thêm Gói Tập Mới</h5>
                </div>
                <div class="card-body">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <strong><i class="fa fa-exclamation-circle"></i> Lỗi:</strong>
                            <ul style="margin-top: 10px; margin-bottom: 0;">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form method="post" action="/admin/package/create">
                        @Html.AntiForgeryToken()

                        <!-- Tên gói tập -->
                        <div class="mb-3">
                            <label class="form-label" for="PackageName">Tên Gói Tập *</label>
                            <input type="text" class="form-control" id="PackageName" name="PackageName" 
                                   placeholder="Nhập tên gói tập" 
                                   value="@Model?.PackageName" required />
                            @if (ViewData.ModelState.TryGetValue("PackageName", out var errors))
                            {
                                @foreach (var error in errors.Errors)
                                {
                                    <span class="text-danger small">@error.ErrorMessage</span>
                                }
                            }
                        </div>

                        <!-- Giá -->
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label" for="Price">Giá (₫) *</label>
                                    <input type="number" class="form-control" id="Price" name="Price" 
                                           placeholder="Nhập giá" 
                                           value="@Model?.Price" min="0" required />
                                    @if (ViewData.ModelState.TryGetValue("Price", out var priceErrors))
                                    {
                                        @foreach (var error in priceErrors.Errors)
                                        {
                                            <span class="text-danger small">@error.ErrorMessage</span>
                                        }
                                    }
                                </div>
                            </div>

                            <!-- Thời hạn -->
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label" for="DurationDays">Thời Hạn (ngày) *</label>
                                    <input type="number" class="form-control" id="DurationDays" name="DurationDays" 
                                           placeholder="Nhập thời hạn tính bằng ngày" 
                                           value="@Model?.DurationDays" min="1" required />
                                    @if (ViewData.ModelState.TryGetValue("DurationDays", out var durationErrors))
                                    {
                                        @foreach (var error in durationErrors.Errors)
                                        {
                                            <span class="text-danger small">@error.ErrorMessage</span>
                                        }
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Mô tả -->
                        <div class="mb-3">
                            <label class="form-label" for="Description">Mô Tả *</label>
                            <textarea class="form-control" id="Description" name="Description" rows="4"
                                      placeholder="Nhập mô tả gói tập" required>@Model?.Description</textarea>
                            @if (ViewData.ModelState.TryGetValue("Description", out var descErrors))
                            {
                                @foreach (var error in descErrors.Errors)
                                {
                                    <span class="text-danger small">@error.ErrorMessage</span>
                                }
                            }
                        </div>

                        <!-- Hình ảnh gói tập -->
                        <div class="mb-3">
                            <label class="form-label" for="ImageUrl">Hình Ảnh Gói Tập</label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="ImageUrl" name="ImageUrl" 
                                       placeholder="Nhập URL hình ảnh hoặc chọn từ thư mục" 
                                       value="@Model?.ImageUrl" />
                                <button class="btn btn-outline-secondary" type="button" id="uploadImageBtn">
                                    <i class="fa fa-upload"></i> Chọn Hình
                                </button>
                            </div>
                            <small class="text-muted d-block mt-2">
                                Ví dụ: /images/packages/fatlose.jpg hoặc https://example.com/image.jpg
                            </small>
                            @if (ViewData.ModelState.TryGetValue("ImageUrl", out var imageErrors))
                            {
                                @foreach (var error in imageErrors.Errors)
                                {
                                    <span class="text-danger small">@error.ErrorMessage</span>
                                }
                            }
                            <!-- Image Preview -->
                            <div id="imagePreview" style="margin-top: 15px; text-align: center;">
                                @if (!string.IsNullOrEmpty(Model?.ImageUrl))
                                {
                                    <img src="@Model.ImageUrl" alt="Package Image" style="max-width: 200px; max-height: 150px; border-radius: 5px;" />
                                }
                            </div>
                        </div>

                        <!-- Loại gói tập -->
                        <div class="mb-3">
                            <label class="form-label" for="PackageType">Loại Gói Tập</label>
                            <select class="form-control" id="PackageType" name="PackageType">
                                <option value="">-- Không chọn --</option>
                                <option value="Online">Online</option>
                                <option value="Offline">Offline</option>
                                <option value="Combo">Combo</option>
                            </select>
                        </div>

                        <!-- Danh mục -->
                        <div class="mb-3">
                            <label class="form-label" for="Category">Danh Mục</label>
                            <input type="text" class="form-control" id="Category" name="Category" 
                                   placeholder="Ví dụ: FatLoss, Muscle, Strength" 
                                   value="@Model?.Category" />
                        </div>

                        <!-- Tính năng -->
                        <div class="mb-3">
                            <label class="form-label" for="Features">Tính Năng</label>
                            <textarea class="form-control" id="Features" name="Features" rows="3"
                                      placeholder="Nhập các tính năng của gói tập (cách nhau bằng dấu phẩy)">@Model?.Features</textarea>
                            <small class="text-muted">Ví dụ: Huấn luyện viên cá nhân, Dinh dưỡng tư vấn, Thiết bị hiện đại</small>
                        </div>

                        <!-- Số buổi tối đa -->
                        <div class="mb-3">
                            <label class="form-label" for="MaxSessions">Số Buổi Tối Đa</label>
                            <input type="number" class="form-control" id="MaxSessions" name="MaxSessions" 
                                   placeholder="Nhập số buổi tối đa (0 = không giới hạn)" 
                                   value="@Model?.MaxSessions" min="0" />
                        </div>

                        <!-- Trạng thái -->
                        <div class="mb-3">
                            <label class="form-label" for="Status">Trạng Thái *</label>
                            <select class="form-control" id="Status" name="Status" required>
                                <option value="Active" selected>Hoạt động</option>
                                <option value="Inactive">Không hoạt động</option>
                            </select>
                            @if (ViewData.ModelState.TryGetValue("Status", out var statusErrors))
                            {
                                @foreach (var error in statusErrors.Errors)
                                {
                                    <span class="text-danger small">@error.ErrorMessage</span>
                                }
                            }
                        </div>

                        <!-- Nút hành động -->
                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary" style="background: #f36100; border: none; padding: 10px 30px;">
                                <i class="fa fa-save"></i> Thêm Gói Tập
                            </button>
                            <a href="/admin/package/index" class="btn btn-secondary" style="padding: 10px 30px;">
                                <i class="fa fa-times"></i> Hủy
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control:focus {
        border-color: #f36100;
        box-shadow: 0 0 0 0.2rem rgba(243, 97, 0, 0.25);
    }

    .form-label {
        font-weight: 600;
        color: #333;
        margin-bottom: 8px;
    }

    .btn-primary:hover {
        background-color: #e55a00 !important;
    }

    .text-muted {
        font-size: 0.875rem;
    }
</style>

@section Scripts {
    <script>
        // Image URL Change Handler
        document.getElementById('ImageUrl').addEventListener('change', function() {
            updateImagePreview();
        });

        // Image Preview Update
        function updateImagePreview() {
            const imageUrl = document.getElementById('ImageUrl').value;
            const previewDiv = document.getElementById('imagePreview');
            
            if (imageUrl) {
                previewDiv.innerHTML = `<img src="${imageUrl}" alt="Package Image" style="max-width: 200px; max-height: 150px; border-radius: 5px; border: 2px solid #f36100;" onerror="this.src='/images/placeholder.png'" />`;
            } else {
                previewDiv.innerHTML = '';
            }
        }

        // Upload Button Handler
        document.getElementById('uploadImageBtn').addEventListener('click', function(e) {
            e.preventDefault();
            const url = prompt('Nhập đường dẫn hình ảnh hoặc URL:');
            if (url) {
                document.getElementById('ImageUrl').value = url;
                updateImagePreview();
            }
        });
    </script>
}
